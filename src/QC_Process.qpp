//! Returns process information for the process managed by the current object
/**
    @return a @ref MemorySummaryInfo hash<auto> of memory info

    @throw PROCESS-GETMEMORYINFO-ERROR an error occurred querying the process's memory usage (PID does not exist or no
    permission to read the process's virtual memory tables)
    @throw PROCESS-GETMEMORYINFO-UNSUPPORTED-ERROR this exception is thrown if there is no implementation for this
    method on the current platform
    @throw PROCESS-CHECK-ERROR in case child handle was not properly initialized

    @note
    - this method has been implemented for Linux and MacOS only; on all other platforms a
      \c PROCESS-GETMEMORYINFO-UNSUPPORTED-ERROR exception is thrown
    - on MacOS the memory of another process cannot be read unless the calling process has root privileges or the
      process has the \c "com.apple.system-task-ports" entitlement

    @see HAVE_PROCESS_GETMEMORYINFO
*/
hash<MemorySummaryInfo> Process::getMemorySummaryInfo() {
    int pid = priv->id(xsink);
    if (*xsink) {
        return QoreValue();
    }
    return ProcessPriv::getMemorySummaryInfo(pid, xsink);
}

//! Returns the number of file descriptors open for the given PID
/** @param pid the PID of the process
    @return the number of file descriptors open for the given PID

    @throw PROCESS-GETDESCRIPTORCOUNT-ERROR an error occurred getting the descriptor count (PID does not exist or no
    permission to read the process's file descriptor table)
    @throw PROCESS-GETDESCRIPTORCOUNT-UNSUPPORTED-ERROR this exception is thrown if there is no implementation for
    this method on the current platform

    @see
    - @ref HAVE_PROCESS_GETDESCRIPTORCOUNT
*/
int Process::getDescriptorCount() {
    int pid = priv->id(xsink);
    if (*xsink) {
        return QoreValue();
    }
    return ProcessPriv::getDescriptorCount(xsink, pid);
}

//! Search for full path of command in current process's PATH
/**
    @param command command name

    @return string with full path of the \c command

    @throw PROCESS-SEARCH-PATH-ERROR in case the \c command is not found in given PATH
    @throw FILESYSTEM-ACCESS-DENIED the program found cannot be read in the current sandbox
 */
static *string Process::searchPath(string command) [flags=NAMED_ARGS] {
    boost::filesystem::path p = ProcessPriv::optsPath(command->c_str(), 0, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreStringNode(p.string());
}

//! Search for full path of command in current process's PATH
/**
    @param command command name
    @param options a hash with process options. @ref process_options - \c path is important here

    @return string with full path of the \c command

    @throw PROCESS-SEARCH-PATH-ERROR in case the \c command is not found in given PATH
    @throw FILESYSTEM-ACCESS-DENIED the program found cannot be read in the current sandbox
 */
static *string Process::searchPath(string command, hash<auto> options) [flags=NAMED_ARGS] {
    boost::filesystem::path p = ProcessPriv::optsPath(command->c_str(), options, xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreStringNode(p.string());
}

//! Returns process information for the current process
/**
    @return a @ref MemorySummaryInfo hash of memory info

    @throw PROCESS-GETMEMORYINFO-ERROR an error occurred querying the process's memory usage (PID does not exist or no
    permission to read the process's virtual memory tables)
    @throw PROCESS-GETMEMORYINFO-UNSUPPORTED-ERROR this exception is thrown if there is no implementation for this
    method on the current platform

    @note
    - this method has been implemented for Linux and MacOS only; on all other platforms a
      \c PROCESS-GETMEMORYINFO-UNSUPPORTED-ERROR exception is thrown
    - on MacOS the memory of another process cannot be read unless the calling process has root privileges or the
      process has the \c "com.apple.system-task-ports" entitlement

    @see HAVE_PROCESS_GETMEMORYINFO
*/
static hash<MemorySummaryInfo> Process::getMemorySummaryInfo() {
    return ProcessPriv::getMemorySummaryInfo(getpid(), xsink);
}

//! Returns process information for the given PID
/**
    @param pid the PID of the process

    @return a @ref MemorySummaryInfo hash of memory info

    @throw PROCESS-GETMEMORYINFO-ERROR an error occurred querying the process's memory usage (PID does not exist or no
    permission to read the process's virtual memory tables)
    @throw PROCESS-GETMEMORYINFO-UNSUPPORTED-ERROR this exception is thrown if there is no implementation for this
    method on the current platform

    @note
    - this method has been implemented for Linux and MacOS only; on all other platforms a
      \c PROCESS-GETMEMORYINFO-UNSUPPORTED-ERROR exception is thrown
    - on MacOS the memory of another process cannot be read unless the calling process has root privileges or the
      process has the \c "com.apple.system-task-ports" entitlement

    @see HAVE_PROCESS_GETMEMORYINFO
*/
static hash<MemorySummaryInfo> Process::getMemorySummaryInfo(int pid) [flags=NAMED_ARGS] {
    return ProcessPriv::getMemorySummaryInfo(pid, xsink);
}

//! Returns @ref Qore::True "True" if the process is running, @ref Qore::False "False" if not
/**
    @param pid the PID of the process

    @return @ref Qore::True "True" if the process is running, @ref Qore::False "False" if not

    @throw PROCESS-CHECKPID-UNSUPPORTED-ERROR this exception is thrown if there is no implementation for this method
    on the current platform

    @note this method has been implemented for Unix and Unix-like systems only; on all other platforms a
    \c PROCESS-CHECKPID-UNSUPPORTED-ERROR exception is thrown

    @see
    - @ref HAVE_PROCESS_CHECKPID
    - @ref Process::running()
*/
static bool Process::checkPid(int pid) [flags=NAMED_ARGS] {
    return ProcessPriv::checkPid(pid, xsink);
}

//! terminate a process unconditionally given its PID
/**
    @param pid PID of the process to terminate

    @throw PROCESS-TERMINATE-ERROR insufficient permissions to terminate process
    @throw PROCESS-INVALID-PID invalid PID
    @throw PROCESS-TERMINATE-UNSUPPORTED-ERROR this exception is thrown if there is no implementation for this method
    on the current platform

    @note this method will also clean up any child processes if necessary (i.e. on Unix-like platforms) in case the
    process killed is a child of the current process

    @see
    - @ref HAVE_PROCESS_TERMINATE
    - @ref Process::terminate()
*/
static nothing Process::terminate(int pid) [flags=NAMED_ARGS] {
    ProcessPriv::terminate(pid, xsink);
}

//! wait until a given PID terminates
/**
    @param pid PID of the process to wait for

    @throw PROCESS-WAITFORTERMINATION-UNSUPPORTED-ERROR this exception is thrown if there is no implementation for
    this method on the current platform

    @see
    - @ref HAVE_PROCESS_WAITFORTERMINATION
    - @ref Process::terminate()
*/
static nothing Process::waitForTermination(int pid) [flags=NAMED_ARGS] {
    ProcessPriv::waitForTermination(pid, xsink);
}

//! returns a list of three CPU load average values, giving the load average in the last 1, 5, and 15 minutes
/** @par Example:
    @code{.py}
list<float> l = Process::getLoadAvg();
printf("load in the last minute was: %y\n", l[0]);
    @endcode

    @return a list of three CPU load average values, giving the load average in the last 1, 5, and 15 minutes

    @throw PROCESS-GETLOADAVG-ERROR an error occurred calling getloadavg()
*/
static list<float> Process::getLoadAvg() [flags=RET_VALUE_ONLY] {
    double loadavg[3];

    int rc = getloadavg(loadavg, 3);
    if (rc != 3) {
        xsink->raiseException("PROCESS-GETLOADAVG-ERROR", "an error occurred calling getloadavg()");
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> rv(new QoreListNode(floatTypeInfo), xsink);
    for (unsigned i = 0; i < 3; ++i) {
        rv->push(loadavg[i], xsink);
        assert(!*xsink);
    }
    return rv.release();
}

//! Returns the number of file descriptors open for the given PID
/** @param pid the PID of the process
    @return the number of file descriptors open for the given PID

    @throw PROCESS-GETDESCRIPTORCOUNT-ERROR an error occurred getting the descriptor count (PID does not exist or no
    permission to read the process's file descriptor table)
    @throw PROCESS-GETDESCRIPTORCOUNT-UNSUPPORTED-ERROR this exception is thrown if there is no implementation for
    this method on the current platform
    @throw FILESYSTEM-ACCESS-DENIED the process's descriptors cannot be read in the current sandbox

    @see
    - @ref HAVE_PROCESS_GETDESCRIPTORCOUNT
*/
static int Process::getDescriptorCount(int pid) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return ProcessPriv::getDescriptorCount(xsink, pid);
}

//! Returns the number of file descriptors open for the current process
/** @return the number of file descriptors open for the given PID

    @throw PROCESS-GETDESCRIPTORCOUNT-ERROR an error occurred getting the descriptor count
    @throw PROCESS-GETDESCRIPTORCOUNT-UNSUPPORTED-ERROR this exception is thrown if there is no implementation for
    this method on the current platform

    @see
    - @ref HAVE_PROCESS_GETDESCRIPTORCOUNT
*/
static int Process::getDescriptorCount() [flags=RET_VALUE_ONLY] {
    return ProcessPriv::getDescriptorCount(xsink, getpid());
}

//! Run a command and return the result
/** This is a convenience method that runs a command, waits for it to complete (with optional timeout),
    and returns the stdout, stderr, and exit code.

    @par Example:
    @code{.py}
# Run a simple command
hash<ProcessResult> result = Process::run("ls", ("-la",));
if (result.ok && result.exit_code == 0) {
    printf("Output: %s\n", result.stdout);
} else {
    printf("Error: %s\n", result.stderr);
}

# Run with timeout
result = Process::run("long_running_task", NOTHING, NOTHING, 30s);
if (!result.ok) {
    printf("Process timed out\n");
}
    @endcode

    @param command the command to run
    @param arguments optional list of arguments to pass to the command
    @param options optional hash of process options (see @ref process_options); note that stdout and stderr
        stream options are not supported with this method
    @param timeout optional timeout in milliseconds; if 0 or not provided, waits indefinitely

    @return a @ref ProcessResult hash with stdout, stderr, exit_code, and ok fields

    @throw PROCESS-CONSTRUCTOR-ERROR in case of error starting the process
    @throw PROCESS-SEARCH-PATH-ERROR in case the command is not found in PATH

    @note If the process times out, it will be terminated and the \c ok field will be @ref Qore::False "False"
*/
static hash<ProcessResult> Process::run(string command, *softlist<softstring> arguments, *hash<auto> options,
        timeout timeout = 0) [flags=NAMED_ARGS] {
    return ProcessPriv::run(command->c_str(), arguments, options, timeout, xsink);
}

//! Check if a command exists in the system PATH
/** This is a convenience method to check if a command is available without launching it.

    @par Example:
    @code{.py}
if (Process::commandExists("docker")) {
    printf("Docker is installed\n");
}
    @endcode

    @param command the command to check for

    @return @ref Qore::True "True" if the command exists in PATH, @ref Qore::False "False" otherwise
*/
static bool Process::commandExists(string command) [flags=NAMED_ARGS] {
    try {
        ProcessPriv::optsPath(command->c_str(), nullptr, xsink);
        if (*xsink) {
            xsink->clear();
            return false;
        }
        return true;
    } catch (...) {
        return false;
    }
}

//! Returns resource usage information for terminated child processes
/** This method returns cumulative resource usage for all terminated child processes.

    @par Example:
    @code{.py}
Process p("compute_intensive_task");
p.wait();
hash<ResourceUsageInfo> usage = p.getResourceUsage();
printf("CPU time: user=%.2f sys=%.2f\n", usage.user_time, usage.system_time);
printf("Max RSS: %d bytes\n", usage.max_rss);
    @endcode

    @return a @ref ResourceUsageInfo hash with resource usage statistics

    @throw PROCESS-CHECK-ERROR in case child handle was not properly initialized
    @throw PROCESS-GETRESOURCEUSAGE-ERROR in case of error getting resource usage

    @note This returns cumulative stats for all terminated child processes, not just this one
*/
hash<ResourceUsageInfo> Process::getResourceUsage() {
    return priv->getResourceUsage(xsink);
}

//! Returns resource usage information for the current process
/** @par Example:
    @code{.py}
hash<ResourceUsageInfo> usage = Process::getResourceUsage();
printf("CPU time: user=%.2f sys=%.2f\n", usage.user_time, usage.system_time);
    @endcode

    @return a @ref ResourceUsageInfo hash with resource usage statistics

    @throw PROCESS-GETRESOURCEUSAGE-ERROR in case of error getting resource usage
*/
static hash<ResourceUsageInfo> Process::getResourceUsage() {
    return ProcessPriv::getResourceUsage(getpid(), xsink);
}

//! Returns resource usage information for a specific process
/** @par Example:
    @code{.py}
hash<ResourceUsageInfo> usage = Process::getResourceUsage(pid);
printf("CPU time: user=%.2f sys=%.2f\n", usage.user_time, usage.system_time);
    @endcode

    @param pid the PID of the process

    @return a @ref ResourceUsageInfo hash with resource usage statistics

    @throw PROCESS-GETRESOURCEUSAGE-ERROR in case of error getting resource usage
    @throw PROCESS-GETRESOURCEUSAGE-UNSUPPORTED-ERROR if getting resource usage for arbitrary PIDs
        is not supported on this platform (only supported on Linux)

    @note On Linux, this reads from /proc/PID/stat.  Not all fields are available.
*/
static hash<ResourceUsageInfo> Process::getResourceUsage(int pid) [flags=NAMED_ARGS] {
    return ProcessPriv::getResourceUsage(pid, xsink);
}

//! Returns a list of child PIDs for this process
/** @par Example:
    @code{.py}
Process p("bash", ("-c", "sleep 100 & sleep 100 & wait"));
list<int> children = p.getChildPids();
printf("Child processes: %y\n", children);
    @endcode

    @return a list of child PIDs

    @throw PROCESS-CHECK-ERROR in case child handle was not properly initialized
    @throw PROCESS-GETCHILDPIDS-ERROR in case of error getting child PIDs
    @throw PROCESS-GETCHILDPIDS-UNSUPPORTED-ERROR if getting child PIDs is not supported on this platform

    @note On Linux, this uses /proc/PID/task/PID/children if available, otherwise scans /proc
*/
list<int> Process::getChildPids() {
    return priv->getChildPids(xsink);
}

//! Returns a list of child PIDs for a specific process
/** @par Example:
    @code{.py}
list<int> children = Process::getChildPids(getpid());
printf("My child processes: %y\n", children);
    @endcode

    @param pid the PID to get children for

    @return a list of child PIDs

    @throw PROCESS-GETCHILDPIDS-ERROR in case of error getting child PIDs
    @throw PROCESS-GETCHILDPIDS-UNSUPPORTED-ERROR if getting child PIDs is not supported on this platform
    @throw FILESYSTEM-ACCESS-DENIED \c /proc cannot be read in the current sandbox
*/
static list<int> Process::getChildPids(int pid) [flags=NAMED_ARGS] {
    return ProcessPriv::getChildPids(pid, xsink);
}

//! Terminates this process
/** This method terminates the main process.

    @par Example:
    @code{.py}
Process p("bash", ("-c", "while true; do sleep 1; done"));
p.terminateTree();  # Kills bash
    @endcode

    @return @ref Qore::True "True" if the process was terminated successfully

    @throw PROCESS-CHECK-ERROR in case child handle was not properly initialized
    @throw PROCESS-TERMINATE-ERROR in case of error terminating the process

    @note Currently this method only terminates the main process. Child process termination
    is planned for a future release. For now, use Process::getChildPids() to manually
    enumerate and terminate child processes if needed.
*/
bool Process::terminateTree() {
    return priv->terminateTree(xsink);
}

//! Execute a pipeline of commands and return the final output
/** This method chains multiple commands together, connecting the stdout of each command
    to the stdin of the next, similar to shell pipes.

    @par Example:
    @code{.py}
# Equivalent to: cat file.txt | grep pattern | sort | uniq
hash<ProcessResult> result = Process::pipeline(
    ("cat", "file.txt"),
    ("grep", "pattern"),
    ("sort",),
    ("uniq",)
);
printf("Output: %s\n", result.stdout);
    @endcode

    @param commands a list of commands, where each command is a list containing the command and its arguments

    @return a @ref ProcessResult hash with the final stdout, combined stderr from all processes,
        the exit code of the last process, and ok=True if all processes succeeded

    @throw PROCESS-PIPELINE-ERROR if the pipeline is empty or invalid
    @throw PROCESS-CONSTRUCTOR-ERROR if any process fails to start

    @note
    - All processes in the pipeline are started concurrently
    - stderr from all processes is collected and combined in the result
    - The exit code in the result is from the last process in the pipeline
    - If any process fails, the ok field will be False
*/
static hash<ProcessResult> Process::pipeline(softlist<softlist<softstring>> commands) [flags=NAMED_ARGS] {
    if (!commands || !commands->size()) {
        xsink->raiseException("PROCESS-PIPELINE-ERROR", "pipeline requires at least one command");
        return QoreValue();
    }

    size_t numCommands = commands->size();

    // For a single command, just use run()
    if (numCommands == 1) {
        const QoreListNode* cmd = commands->retrieveEntry(0).get<QoreListNode>();
        if (!cmd || !cmd->size()) {
            xsink->raiseException("PROCESS-PIPELINE-ERROR", "each command must be a non-empty list");
            return QoreValue();
        }
        QoreStringValueHelper cmdStr(cmd->retrieveEntry(0));
        ReferenceHolder<QoreListNode> args(new QoreListNode(stringTypeInfo), xsink);
        for (size_t i = 1; i < cmd->size(); i++) {
            if (!(i % 100) && qore_check_cancel(xsink, "Process::pipeline")) {
                return QoreValue();
            }
            QoreStringValueHelper argStr(cmd->retrieveEntry(i));
            args->push(new QoreStringNode(argStr->c_str()), xsink);
        }
        return ProcessPriv::run(cmdStr->c_str(), *args, nullptr, 0, xsink);
    }

    // For multiple commands, use shell to create the pipeline
    // Build shell command: cmd1 arg1 | cmd2 arg2 | cmd3 arg3
    QoreStringNode* shellCmd = new QoreStringNode;
    bool first = true;

    ConstListIterator cmdIter(commands);
    size_t cmd_i = 0;
    while (cmdIter.next()) {
        if (!(++cmd_i % 100) && qore_check_cancel(xsink, "Process::pipeline")) {
            shellCmd->deref();
            return QoreValue();
        }
        QoreValue cmdVal = cmdIter.getValue();
        if (cmdVal.getType() != NT_LIST) {
            shellCmd->deref();
            xsink->raiseException("PROCESS-PIPELINE-ERROR", "each command must be a list, got %s",
                cmdVal.getTypeName());
            return QoreValue();
        }

        const QoreListNode* cmd = cmdVal.get<const QoreListNode>();
        if (!cmd || !cmd->size()) {
            shellCmd->deref();
            xsink->raiseException("PROCESS-PIPELINE-ERROR", "each command must be a non-empty list");
            return QoreValue();
        }

        if (!first) {
            shellCmd->concat(" | ");
        }
        first = false;

        // Add command and arguments (with proper quoting)
        for (size_t i = 0; i < cmd->size(); i++) {
            if (i && !(i % 100) && qore_check_cancel(xsink, "Process::pipeline")) {
                shellCmd->deref();
                return QoreValue();
            }
            if (i > 0) shellCmd->concat(' ');

            QoreStringValueHelper argStr(cmd->retrieveEntry(i));
            const char* arg = argStr->c_str();

            // Check if quoting is needed
            bool needsQuote = false;
            size_t char_i = 0;
            for (const char* p = arg; *p; p++) {
                if (!(++char_i % 100) && qore_check_cancel(xsink, "Process::pipeline")) {
                    shellCmd->deref();
                    return QoreValue();
                }
                if (*p == ' ' || *p == '\t' || *p == '"' || *p == '\'' ||
                    *p == '|' || *p == '&' || *p == ';' || *p == '<' || *p == '>' ||
                    *p == '(' || *p == ')' || *p == '$' || *p == '`' || *p == '\\' ||
                    *p == '\n') {
                    needsQuote = true;
                    break;
                }
            }

            if (needsQuote) {
                // Use single quotes, escaping any single quotes in the string
                shellCmd->concat('\'');
                char_i = 0;
                for (const char* p = arg; *p; p++) {
                    if (!(++char_i % 100) && qore_check_cancel(xsink, "Process::pipeline")) {
                        shellCmd->deref();
                        return QoreValue();
                    }
                    if (*p == '\'') {
                        shellCmd->concat("'\\''");
                    } else {
                        shellCmd->concat(*p);
                    }
                }
                shellCmd->concat('\'');
            } else {
                shellCmd->concat(arg);
            }
        }
    }

    // Create hash with shell option
    ReferenceHolder<QoreHashNode> opts(new QoreHashNode(autoTypeInfo), xsink);
    opts->setKeyValue("shell", true, xsink);

    // Use the shell command directly with the shell option
    QoreHashNode* result = ProcessPriv::run(shellCmd->c_str(), nullptr, *opts, 0, xsink);
    shellCmd->deref();
    return result;
}

//! Returns the command line of a process as a string
/** @par Example:
    @code{.py}
string cmdline = Process::getCommandLine(getpid());
printf("Current process: %s\n", cmdline);
    @endcode

    @param pid the PID of the process

    @return the command line of the process as a string with arguments separated by spaces

    @throw PROCESS-GETCOMMANDLINE-ERROR if the command line cannot be read (e.g. process does not exist
        or insufficient permissions)
    @throw PROCESS-GETCOMMANDLINE-UNSUPPORTED-ERROR if this method is not available on the current platform
    @throw FILESYSTEM-ACCESS-DENIED the command line cannot be read in the current sandbox

    @note
    - Supported on Linux, macOS, FreeBSD, DragonFly, NetBSD, and OpenBSD
    - On all platforms, returns the full command line with arguments separated by spaces
    - On macOS, may require elevated privileges to read command lines of other users' processes
    - On FreeBSD/DragonFly/NetBSD/OpenBSD, requires the kvm library

    @see HAVE_PROCESS_GETCOMMANDLINE

    @since process 2.1
*/
static string Process::getCommandLine(int pid) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return ProcessPriv::getCommandLine(pid, xsink);
}

//! Returns the path to the executable file of the current process
/** @par Example:
    @code{.py}
string exe = Process::getExecutablePath();
    @endcode

    @return the absolute path to the executable file of the current process; for a script, this is the path to the
    interpreter running it

    @throw PROCESS-GETEXECUTABLEPATH-ERROR if the path cannot be read
    @throw PROCESS-GETEXECUTABLEPATH-UNSUPPORTED-ERROR if this method is not available on the current platform
    @throw FILESYSTEM-ACCESS-DENIED the executable path cannot be read in the current sandbox

    @see HAVE_PROCESS_GETEXECUTABLEPATH

    @since process 2.1
*/
static string Process::getExecutablePath() [flags=RET_VALUE_ONLY] {
    return ProcessPriv::getExecutablePath(getpid(), xsink);
}

//! Returns the path to the executable file of the given process
/** @par Example:
    @code{.py}
string exe = Process::getExecutablePath(pid);
    @endcode

    @param pid the PID of the process

    @return the absolute path to the executable file of the process

    @throw PROCESS-GETEXECUTABLEPATH-ERROR if the path cannot be read (e.g. the process does not exist or
        insufficient permissions)
    @throw PROCESS-GETEXECUTABLEPATH-UNSUPPORTED-ERROR if this method is not available on the current platform
    @throw FILESYSTEM-ACCESS-DENIED the executable path cannot be read in the current sandbox

    @note Supported on the same platforms as @ref getCommandLine()

    @see HAVE_PROCESS_GETEXECUTABLEPATH

    @since process 2.1
*/
static string Process::getExecutablePath(int pid) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return ProcessPriv::getExecutablePath(pid, xsink);
}

//! Returns information about the memory of the system
/** @par Example:
    @code{.py}
hash<SystemMemoryInfo> info = Process::getSystemMemoryInfo();
# one worker process for each 2 GiB available
int workers = info.available / (2 * 1024 * 1024 * 1024);
    @endcode

    @return information about the memory of the system, including the memory available to the current process

    @throw PROCESS-GETSYSTEMMEMORYINFO-ERROR if the information cannot be read
    @throw PROCESS-GETSYSTEMMEMORYINFO-UNSUPPORTED-ERROR if this method is not available on the current platform
    @throw FILESYSTEM-ACCESS-DENIED the system memory information cannot be read in the current sandbox

    @note
    - Supported on Linux and macOS
    - On Linux, a memory limit of the control group of the current process (cgroup v1 or v2), such as the limit of
      a container, is returned in \c limit, and the memory remaining under it limits \c available
    - On macOS, a memory limit of the current process (a jetsam limit, as set by \c launchd, for example) is
      returned in \c limit, and the memory remaining under it limits \c available

    @see HAVE_PROCESS_GETSYSTEMMEMORYINFO

    @since process 2.1
*/
static hash<SystemMemoryInfo> Process::getSystemMemoryInfo() [flags=RET_VALUE_ONLY] {
    return ProcessPriv::getSystemMemoryInfo(xsink);
}

//! Returns a list of PIDs that have a listening TCP socket on the given port
/** @par Example:
    @code{.py}
list<int> pids = Process::getPidsForPort(8001);
if (pids) {
    printf("Port 8001 is used by PIDs: %y\n", pids);
}
    @endcode

    @param port the TCP port number to check (1-65535)

    @return a list of PIDs that are listening on the given port; an empty list if no process is listening

    @throw PROCESS-GETPIDSFORPORT-ERROR if the port is invalid or an error occurs scanning process information
    @throw PROCESS-GETPIDSFORPORT-UNSUPPORTED-ERROR if this method is not available on the current platform
    @throw FILESYSTEM-ACCESS-DENIED \c /proc cannot be read in the current sandbox

    @note
    - On Linux, this scans /proc/net/tcp and /proc/net/tcp6 for listening sockets and matches
      socket inodes to PIDs via /proc/PID/fd; this works on all Linux variants including Alpine (busybox)
    - On macOS, this uses native libproc APIs to enumerate process file descriptors and filter for TCP
      listening sockets; only LISTEN-state sockets are matched
    - On FreeBSD/DragonFly, this uses sysctl KERN_PROC_FILEDESC to enumerate file descriptors
    - May require elevated privileges to see sockets of other users' processes

    @see HAVE_PROCESS_GETPIDSFORPORT

    @since process 2.1
*/
static list<int> Process::getPidsForPort(int port) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return ProcessPriv::getPidsForPort(port, xsink);
}

//! Returns a list of PIDs that have the given Unix domain socket path open
/** @par Example:
    @code{.py}
list<int> pids = Process::getPidsForUnixSocket("/var/run/app.sock");
if (pids) {
    printf("Socket is used by PIDs: %y\n", pids);
}
    @endcode

    @param path the Unix domain socket path to check

    @return a list of PIDs that have the given Unix domain socket open; an empty list if no process has it open

    @throw PROCESS-GETPIDSFORUNIXSOCKET-ERROR if the path is empty or an error occurs scanning process information
    @throw PROCESS-GETPIDSFORUNIXSOCKET-UNSUPPORTED-ERROR if this method is not available on the current platform
    @throw FILESYSTEM-ACCESS-DENIED \c /proc cannot be read in the current sandbox

    @note
    - On Linux, this parses /proc/net/unix to find socket inodes matching the path, then scans /proc/PID/fd
      for matching socket symlinks
    - On macOS, this uses native libproc APIs to enumerate process file descriptors and match Unix socket paths
    - On FreeBSD/DragonFly, this uses sysctl KERN_PROC_FILEDESC to enumerate file descriptors
    - May require elevated privileges to see sockets of other users' processes

    @see HAVE_PROCESS_GETPIDSFORUNIXSOCKET

    @since process 2.1
*/
static list<int> Process::getPidsForUnixSocket(string path) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return ProcessPriv::getPidsForUnixSocket(path->c_str(), xsink);
}
