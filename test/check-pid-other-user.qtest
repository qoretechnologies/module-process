#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.; SPDX-License-Identifier: MIT
%modern
%requires process
%requires QUnit
%requires Util
%exec-class Main

#! Process::checkPid() reports a process of another user as running (qoretechnologies/qore#7182)
/** kill(pid, 0) fails with EPERM for a process of another user, which the caller may not signal, and with ESRCH only
    when there is no such process; checkPid() took any failure for a process that does not run, so a live process of
    another user (a Qorus server running as its own user, checked by a test run as root) looked dead.  PID 1 is a
    process of root: checked from a process of another user, it runs.
*/
class Main inherits QUnit::Test {
    constructor() : Test("checkPid of a process of another user", "1.0") {
        addTestCase("a process of another user runs", \otherUserTest());
        addTestCase("a reaped child does not run", \reapedTest());
        set_return_value(main());
    }

    #! returns the owner of a process, from /proc (Linux) or ps
    private static *int owner(int pid) {
        if (is_dir("/proc/" + pid)) {
            *hash<StatInfo> st = hstat("/proc/" + pid);
            return st.uid;
        }
        *string out = trim(backquote(sprintf("ps -o uid= -p %d 2>/dev/null", pid)));
        return out =~ /^[0-9]+$/ ? out.toInt() : NOTHING;
    }

    otherUserTest() {
        if (!HAVE_PROCESS_CHECKPID) {
            testSkip("Process::checkPid() is not supported on this platform");
        }
        *int pid1_owner = Main::owner(1);
        if (!exists pid1_owner) {
            testSkip("the owner of PID 1 cannot be read");
        }
        int uid = getuid();
        if (uid != pid1_owner) {
            # this process may not signal PID 1: kill(1, 0) fails with EPERM
            assertTrue(Process::checkPid(1), "PID 1 of another user runs");
            return;
        }
        # this process owns PID 1 (root, or the user of a container's first process): the check runs in a child of
        # another user
        if (uid) {
            testSkip("this process owns PID 1 and cannot run a child of another user");
        }
        *string setpriv = trim(`command -v setpriv 2>/dev/null`);
        if (!setpriv) {
            testSkip("setpriv is not available to run a child of another user");
        }
        string script = "%modern\n%requires process\nprint(Process::checkPid(1) ? \"running\" : \"not running\");\n";
        string file = tmp_location() + "/check-pid-other-user-" + getpid() + ".q";
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write(script);
        f.close();
        on_exit unlink(file);
        int status;
        string out = backquote(sprintf("%s --reuid=65534 --regid=65534 --clear-groups -- %s %s 2>&1", setpriv,
            ENV.QORE ?? "qore", file), \status);
        # the user of the child may not reach the interpreter or the module under test (a build in a private home
        # directory)
        if (status && out =~ /LOAD-MODULE-ERROR|Permission denied|cannot open|Operation not permitted/) {
            testSkip("the child of another user cannot load the module under test: " + out);
        }
        assertEq(0, status, out);
        assertEq("running", out, "PID 1 runs for a child of another user");
    }

    reapedTest() {
        if (!HAVE_PROCESS_CHECKPID) {
            testSkip("Process::checkPid() is not supported on this platform");
        }
        Process p("true");
        int pid = p.id();
        p.wait();
        # the child was reaped: its PID does not exist (kill() fails with ESRCH)
        assertFalse(Process::checkPid(pid), sprintf("reaped child %d", pid));
    }
}
