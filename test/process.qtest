    closeStdinTest() {
        # Test that closeStdin() allows EOF-reading programs to finish
        Process p("test_stdin_eof.q", {"path": (m_prefix,)});

        p.write("cherry\n");
        p.write("apple\n");
        p.write("banana\n");
        p.closeStdin();  # Signal EOF

        assertTrue(p.wait(5s), "Process should finish after stdin closed");

        string output = "";
        while (True) {
            *string str = p.readStdout(1000);
            if (!str) {
                break;
            }
            output += str;
        }

        assertEq("apple\nbanana\ncherry", output, "Output should be sorted");
        assertEq(0, p.exitCode(), "Exit code should be 0");
    }

    sendSignalTest() {
        # Test graceful termination with SIGTERM
        {
            Process p("test_signal.q", {"path": (m_prefix,)});
            sleep(200ms);  # Give process time to set up signal handler
            assertTrue(p.running(), "Process should be running");

            assertTrue(p.sendSignal(SIGTERM), "sendSignal should return true");

            # Wait for graceful shutdown
            assertTrue(p.wait(5s), "Process should exit after SIGTERM");
            # Note: exit code varies by platform - don't assert on specific value
            # The important thing is the process terminated after receiving the signal
        }

        # Test sending signal to already-terminated process
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,)});
            p.wait();  # Wait for process to exit
            # Process has exited, sendSignal should fail
            assertThrows("PROCESS-SIGNAL-ERROR", \p.sendSignal(), SIGTERM);
        }
    }

    edgeCaseTests() {
        # Test with empty environment
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,), "env": {}});
            p.wait();
            # Process may fail due to missing PATH but should not crash
            assertTrue(True, "Empty env should not crash");
        }

        # Test timeout = 0
        {
            Process p(getTestValue("testSleep"), 2, {"path": (m_prefix,)});
            assertFalse(p.wait(0), "wait(0) should return immediately");
            p.terminate();
        }

        # Test wait after process already finished
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,)});
            p.wait();
            assertTrue(p.wait(), "wait() on finished process should return true");
            assertTrue(p.wait(1s), "wait(timeout) on finished process should return true");
        }

        # Test readStdout with 0 bytes
        {
            Process p(getTestValue("testOutput"), {"path": (m_prefix,)});
            assertEq(NOTHING, p.readStdout(0), "readStdout(0) should return NOTHING");
            assertEq(NOTHING, p.readStderr(0), "readStderr(0) should return NOTHING");
            assertEq(NOTHING, p.readStdoutBinary(0), "readStdoutBinary(0) should return NOTHING");
            assertEq(NOTHING, p.readStderrBinary(0), "readStderrBinary(0) should return NOTHING");
            p.wait();
        }
    }

    negativeTests() {
        # Test double detach
        {
            Process p(getTestValue("testSleep"), 5, {"path": (m_prefix,)});
            int pid = p.id();
            p.detach();
            # Second detach should not crash
            p.detach();
            # Terminate using static method with the saved PID
            Process::terminate(pid);
        }

        # Test getDescriptorCount with invalid PID
        if (HAVE_PROCESS_GETDESCRIPTORCOUNT) {
            assertThrows("PROCESS-GETDESCRIPTORCOUNT-ERROR", \Process::getDescriptorCount(), -1);
            assertThrows("PROCESS-GETDESCRIPTORCOUNT-ERROR", \Process::getDescriptorCount(), 999999999);
        }

        # Test getMemorySummaryInfo with invalid PID
        if (HAVE_PROCESS_GETMEMORYINFO) {
            assertThrows("PROCESS-GETMEMORYINFO-ERROR", \Process::getMemorySummaryInfo(), -1);
            assertThrows("PROCESS-GETMEMORYINFO-ERROR", \Process::getMemorySummaryInfo(), 999999999);
        }

        # Test constructor with negative PID
        assertThrows("PROCESS-CONSTRUCTOR-ERROR", sub () { Process p(-1); });

        # Test writing to process after stdin closed
        {
            Process p("test_stdin_eof.q", {"path": (m_prefix,)});
            p.closeStdin();
            # Write after close should not crash (may silently fail)
            p.write("test");
            if (!p.wait(5s)) {
                p.terminate();
            }
        }

        # Test Process::terminate() with invalid PID
        assertThrows("PROCESS-TERMINATE-ERROR", \Process::terminate(), -1);

        # Test invalid encoding option type
        assertThrows("PROCESS-OPTION-ERROR", sub () {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,), "encoding": 123});
        });

        # Test invalid cwd option type
        assertThrows("PROCESS-OPTION-ERROR", sub () {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,), "cwd": 123});
        });

        # Test invalid path option type
        assertThrows("PROCESS-OPTION-ERROR", sub () {
            Process p(getTestValue("testTrue"), {"path": "not-a-list"});
        });
    }

    largeIOTest() {
        # Test basic I/O with test_io.q
        # Note: test_io.q reads only a few lines, not all input
        hash<auto> opts = {"path": (m_prefix,)};

        Process p("test_io.q", opts);

        # Send first line (echoed to stdout)
        p.write("hello\n");
        sleep(100ms);

        # Send second line (echoed to stdout and stderr)
        p.write("world\n");
        sleep(100ms);

        # Send exit code
        p.write("0\n");

        # Wait with timeout
        if (!p.wait(10s)) {
            p.terminate();
            assertTrue(False, "Process should complete within timeout");
            return;
        }

        assertEq(0, p.exitCode(), "Exit code should be 0");
    }

    specialCharsTest() {
        # Test arguments with special characters
        hash<auto> opts = {"path": (m_prefix,)};

        # Test with spaces in arguments
        {
            Process p("test_env.q", ("SPECIAL_VAR", "value with spaces"),
                opts + {"env": Process::getEnvironment() + {"SPECIAL_VAR": "value with spaces"}});
            p.wait();
            assertEq(0, p.exitCode(), "Spaces in args should work");
        }

        # Test with quotes in arguments
        {
            Process p("test_env.q", ("QUOTE_VAR", "value\"with\"quotes"),
                opts + {"env": Process::getEnvironment() + {"QUOTE_VAR": "value\"with\"quotes"}});
            p.wait();
            assertEq(0, p.exitCode(), "Quotes in args should work");
        }

        # Test with unicode in arguments
        {
            Process p("test_env.q", ("UNICODE_VAR", "\u00e9\u00e8\u00ea"),
                opts + {"env": Process::getEnvironment() + {"UNICODE_VAR": "\u00e9\u00e8\u00ea"}});
            p.wait();
            assertEq(0, p.exitCode(), "Unicode in args should work");
        }
    }

    binaryNulTest() {
        # Test writing binary data with embedded NUL bytes
        hash<auto> opts = {"path": (m_prefix,)};
        Process p("test_io.q", opts);

        # test_io.q protocol: readLine (line 1), readLine (line 2), sleep 2s, readLine (exit code)
        binary data = <00010203040500060708>;  # Binary with NUL in middle
        p.write(data);
        p.write("\n");       # first line: binary data with NUL
        p.write("test\n");   # second line expected by test_io.q
        p.write("0\n");      # third line: exit code

        # Wait for child to exit (test_io.q has a 2s internal sleep)
        assertTrue(p.wait(15s), "Binary with NUL should not hang");
        assertEq(0, p.exitCode(), "Binary with NUL should not crash");
    }

    runTest() {
        # Test basic run()
        {
            hash<auto> result = Process::run(getTestValue("testTrue"), NOTHING, {"path": (m_prefix,)});
            assertTrue(result.ok, "run() should succeed");
            assertEq(0, result.exit_code, "Exit code should be 0");
            assertEq("", result.stdout, "stdout should be empty for test_true.q");
            assertEq("", result.stderr, "stderr should be empty for test_true.q");
        }

        # Test run() with output
        {
            hash<auto> result = Process::run(getTestValue("testOutput"), NOTHING, {"path": (m_prefix,)});
            assertTrue(result.ok, "run() should succeed");
            assertEq(0, result.exit_code, "Exit code should be 0");
            assertEq("stdout", result.stdout, "stdout should contain 'stdout'");
            assertEq("stderr", result.stderr, "stderr should contain 'stderr'");
        }

        # Test run() with non-zero exit code
        {
            hash<auto> result = Process::run(getTestValue("testFalse"), NOTHING, {"path": (m_prefix,)});
            assertTrue(result.ok, "run() should complete (even with error)");
            assertEq(1, result.exit_code, "Exit code should be 1");
        }

        # Test run() with timeout
        {
            hash<auto> result = Process::run(getTestValue("testSleep"), (5,), {"path": (m_prefix,)}, 1s);
            assertFalse(result.ok, "run() should timeout");
        }

        # Test run() with system command
        {
            hash<auto> result = Process::run("echo", ("hello", "world"));
            assertTrue(result.ok, "run() should succeed");
            assertEq(0, result.exit_code, "Exit code should be 0");
            assertRegex("hello.*world", result.stdout, "stdout should contain 'hello world'");
        }
    }

    commandExistsTest() {
        # Test that common commands exist
        assertTrue(Process::commandExists("ls"), "ls should exist");
        assertTrue(Process::commandExists("echo"), "echo should exist");

        # Test that non-existent command returns false
        assertFalse(Process::commandExists("some-nonexistent-command-12345"), "non-existent command should return false");

        # the test scripts are found if PATH includes their directory (ex: "." while it is the current directory)
        assertEq(scriptDirInPath(), Process::commandExists("test_true.q"),
            "test_true.q is found if PATH includes its directory");
    }

    shellOptionTest() {
        # Test shell option with glob expansion
        {
            hash<auto> result = Process::run("echo *.q", NOTHING, {"shell": True, "cwd": m_prefix});
            assertTrue(result.ok, "shell command should succeed");
            assertEq(0, result.exit_code, "exit code should be 0");
            # The output should contain test scripts (not literal *.q)
            assertTrue(result.stdout.find("test_") > -1, "shell should expand glob");
        }

        # Test shell option with variable expansion
        {
            hash<auto> result = Process::run("echo $HOME", NOTHING, {"shell": True});
            assertTrue(result.ok, "shell command should succeed");
            assertEq(0, result.exit_code, "exit code should be 0");
            assertTrue(result.stdout.size() > 1, "HOME variable should expand");
        }

        # Test shell option with pipe
        {
            hash<auto> result = Process::run("echo hello world | wc -w", NOTHING, {"shell": True});
            assertTrue(result.ok, "shell command should succeed");
            assertEq(0, result.exit_code, "exit code should be 0");
            assertRegex("2", result.stdout, "word count should be 2");
        }
    }

    niceOptionTest() {
        # Test nice option with positive value
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,), "nice": 10});
            p.wait();
            assertEq(0, p.exitCode(), "process with nice should succeed");
        }

        # Test invalid nice value (too high)
        {
            assertThrows("PROCESS-OPTION-ERROR", sub () {
                Process p(getTestValue("testTrue"), {"path": (m_prefix,), "nice": 25});
            });
        }

        # Test invalid nice value (too low)
        {
            assertThrows("PROCESS-OPTION-ERROR", sub () {
                Process p(getTestValue("testTrue"), {"path": (m_prefix,), "nice": -25});
            });
        }

        # Test invalid nice type
        {
            assertThrows("PROCESS-OPTION-ERROR", sub () {
                Process p(getTestValue("testTrue"), {"path": (m_prefix,), "nice": "high"});
            });
        }
    }

    resourceUsageTest() {
        # Test getResourceUsage() for current process
        {
            hash<auto> usage = Process::getResourceUsage();
            # Use assertTrue for comparisons since QUnit assert* have unusual argument order
            assertTrue(usage.user_time >= 0.0, "user_time should be >= 0");
            assertTrue(usage.system_time >= 0.0, "system_time should be >= 0");
            assertTrue(usage.max_rss > 0, "max_rss should be > 0");
        }

        # Test getResourceUsage() for specific PID
        {
            hash<auto> usage = Process::getResourceUsage(getpid());
            assertTrue(usage.user_time >= 0.0, "user_time should be >= 0");
            assertTrue(usage.max_rss > 0, "max_rss should be > 0");
        }

        # Test getResourceUsage() for child process
        {
            Process p(getTestValue("testSleep"), 1, {"path": (m_prefix,)});
            p.wait();
            hash<auto> usage = p.getResourceUsage();
            # Child usage may be zero if child didn't use much CPU
            assertTrue(exists usage.user_time, "user_time should exist");
            assertTrue(exists usage.system_time, "system_time should exist");
        }
    }

    childPidsTest() {
        # Test getChildPids() for process with children
        {
            # Launch bash with two background sleep children. Echo a marker after the
            # children have been forked so we can synchronize deterministically rather
            # than polling.
            Process p("bash", ("-c", "sleep 30 & sleep 30 & echo READY; wait"), {"shell": False});
            on_exit {
                try { p.terminate(); } catch (hash<ExceptionInfo> ex) {}
            }

            # Block until the marker appears; this guarantees both children are spawned.
            *string out = p.readStdout(6, 5000ms);
            assertRegex("READY", out ?? "", "bash should signal that children have spawned");

            if (Qore::PlatformOS == "Linux" || Qore::PlatformOS == "Darwin") {
                list<int> children = p.getChildPids();
                assertGe(2, children.size(), "process should have at least 2 sleep children");
            }
        }

        # Test static getChildPids()
        {
            if (Qore::PlatformOS == "Linux" || Qore::PlatformOS == "Darwin") {
                list<int> children = Process::getChildPids(getpid());
                # Current process may have children from test harness
                assertTrue(exists children, "getChildPids should return a list");
            }
        }

        # Negative tests for getChildPids with invalid PIDs
        {
            # PID 1 (init) should be rejected - prevents accidental system-wide operations
            assertThrows("PROCESS-GETCHILDPIDS-ERROR", sub () {
                Process::getChildPids(1);
            });

            # PID 0 should be rejected
            assertThrows("PROCESS-GETCHILDPIDS-ERROR", sub () {
                Process::getChildPids(0);
            });

            # Negative PIDs should be rejected
            assertThrows("PROCESS-GETCHILDPIDS-ERROR", sub () {
                Process::getChildPids(-1);
            });
        }
    }

    # Negative tests for signal/terminate operations on invalid processes
    invalidProcessTests() {
        # Test sendSignal on already-terminated process
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,)});
            p.wait();
            # Process is now dead, sendSignal should fail gracefully
            assertThrows("PROCESS-SIGNAL-ERROR", sub () {
                p.sendSignal(SIGTERM);
            });
        }

        # Test terminate on already-terminated process
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,)});
            p.wait();
            # Second terminate should handle gracefully (process already dead)
            try {
                p.terminate();
            } catch (hash<ExceptionInfo> ex) {
                # Expected - process already dead
                assertTrue(ex.err =~ /PROCESS/, "should be a PROCESS error");
            }
        }

        # Test that terminate doesn't kill all processes when PID becomes invalid
        # This is a critical safety test - if this fails, it could kill all user processes
        {
            Process p("sleep", ("1",));
            sleep(100ms);
            int originalPid = p.id();
            assertTrue(originalPid > 0, "PID should be positive");
            p.terminate();
            # Verify we didn't kill unrelated processes by checking if common system
            # processes are still running
            assertTrue(Process::checkPid(getpid()), "current process should still be running");
        }
    }

    # terminateTree() kills the process and all its descendants.  Previously it killed only the process, and its
    # children were left running.
    terminateTreeTest() {
        if (Qore::PlatformOS != "Linux" && Qore::PlatformOS != "Darwin") {
            testSkip("descendants are only collected on Linux and macOS");
        }
        # a child, and a grandchild under a second child; the marker is printed by the grandchild's parent after it
        # has started it, when all the processes exist
        Process p("bash", ("-c", "sleep 100 & sh -c 'sleep 100 & echo READY; wait' & wait"));
        *string out = p.readStdout(6, 60s);
        assertRegex("READY", out ?? "", "the processes have been started");

        int pid = p.id();
        list<int> descendants = ();
        list<int> parents = (pid,);
        while (parents) {
            list<int> children = ();
            foreach int parent in (parents) {
                children += Process::getChildPids(parent);
            }
            descendants += children;
            parents = children;
        }
        assertEq(3, descendants.size(), sprintf("the tree has 3 descendants: %y", descendants));

        assertTrue(p.terminateTree());
        assertFalse(p.running(), "the process has ended");
        assertFalse(Process::checkPid(pid), "the process has ended");
        # the method returns when the descendants have ended
        foreach int child in (descendants) {
            assertFalse(Process::checkPid(child), sprintf("descendant %d has ended", child));
        }
    }

    pipelineTest() {
        # Test simple pipeline
        {
            hash<auto> result = Process::pipeline((
                ("echo", "hello world"),
                ("wc", "-w")
            ));
            assertTrue(result.ok, "pipeline should succeed");
            assertEq(0, result.exit_code, "exit code should be 0");
            assertRegex("2", result.stdout, "word count should be 2");
        }

        # Test multi-stage pipeline
        {
            hash<auto> result = Process::pipeline((
                ("echo", "cherry\napple\nbanana"),
                ("sort",),
                ("head", "-1")
            ));
            assertTrue(result.ok, "pipeline should succeed");
            assertRegex("apple", result.stdout, "first sorted line should be apple");
        }

        # Test single command (should work like run)
        {
            hash<auto> result = Process::pipeline((
                ("echo", "hello"),
            ));
            assertTrue(result.ok, "single command pipeline should succeed");
            assertRegex("hello", result.stdout, "output should contain hello");
        }

        # Test pipeline error (empty)
        {
            assertThrows("PROCESS-PIPELINE-ERROR", sub () {
                Process::pipeline(());
            });
        }
    }

    resourceLimitsTest() {
        # Test with cpu limit (process should be killed if exceeds)
        # Note: This is hard to test reliably, so we just verify the option is accepted
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,), "limits": {"cpu": 60}});
            p.wait();
            assertEq(0, p.exitCode(), "process with cpu limit should succeed");
        }

        # Test with memory limit
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,), "limits": {"memory": 1024 * 1024 * 1024}});  # 1GB
            p.wait();
            assertEq(0, p.exitCode(), "process with memory limit should succeed");
        }

        # Test with file limit
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,), "limits": {"files": 1024}});
            p.wait();
            assertEq(0, p.exitCode(), "process with file limit should succeed");
        }

        # Test invalid limits type
        {
            assertThrows("PROCESS-OPTION-ERROR", sub () {
                Process p(getTestValue("testTrue"), {"path": (m_prefix,), "limits": "invalid"});
            });
        }

        # Test multiple limits together
        {
            Process p(getTestValue("testTrue"), {"path": (m_prefix,), "limits": {
                "memory": 1024 * 1024 * 1024,
                "cpu": 60,
                "files": 1024,
                "core": 0,  # Disable core dumps
            }});
            p.wait();
            assertEq(0, p.exitCode(), "process with multiple limits should succeed");
        }
    }

    # run() terminates a child that does not finish in time; the background I/O thread must have finished before
    # the process object is destroyed, otherwise the heap is corrupted (this crashed about every other run of 40
    # iterations), and output of a child that exits before wait() is called must be complete
    repeatedRunTest() {
        for (int i = 0; i < 40; ++i) {
            hash<auto> result = Process::run(getTestValue("testSleep"), (5,), {"path": (m_prefix,)}, 50ms);
            assertFalse(result.ok, sprintf("run %d times out", i));
        }
        for (int i = 0; i < 40; ++i) {
            hash<auto> result = Process::run("echo", ("line", i));
            assertEq(sprintf("line %d\n", i), result.stdout, sprintf("complete output of run %d", i));
        }
    }

    # a sandboxed program cannot start programs, search for them, or inspect processes and the system outside its
    # sandbox root
    sandboxTest() {
        SandboxManager sm();
        sm.setFilesystemSandboxRoot(tmp_location());
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        p.parse("%modern
%requires process
auto sub start() { return new Process(\"/bin/true\"); }
auto sub search() { return Process::searchPath(\"ls\"); }
auto sub memory() { return Process::getSystemMemoryInfo(); }
auto sub exe() { return Process::getExecutablePath(); }
auto sub cmdline() { return Process::getCommandLine(getpid()); }
auto sub descriptors() { return Process::getDescriptorCount(getpid()); }
", "sandbox-test");

        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("start",), "a program outside the root");
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("search",), "a program outside the root");
        if (PlatformOS == "Linux") {
            # these read /proc on Linux
            assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("memory",), "/proc/meminfo");
            assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("exe",), "/proc/PID/exe");
            assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("cmdline",), "/proc/PID/cmdline");
            assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("descriptors",), "/proc/PID/fd");
        }
    }

    # an exception raised by an output stream on the background I/O thread is rethrown in the thread that waits for
    # the process.  Previously the I/O thread ended with the exception still counted as active on it, which stopped
    # the process in a debug build of the library, and the thread that handled the exception released a count that
    # it did not have.
    outputStreamExceptionTest() {
        ThrowingOutputStream stream();
        {
            Process p("sh", ("-c", "echo out"), {"stdout": stream});
            assertThrows("STREAM-TEST-ERROR", "write refused", \p.wait());
            # the exception is rethrown only once
            assertTrue(p.wait());
        }
        # the stream also fails for standard error, while standard output is read
        {
            Process p("sh", ("-c", "echo out; echo err >&2"), {"stderr": stream});
            assertThrows("STREAM-TEST-ERROR", "write refused", \p.wait());
            assertEq("out\n", p.readStdout(100));
        }
    }

    # a stream implemented in Qore runs the methods of its object when it is written to; the object is kept while the
    # process uses the stream.  Previously only the stream was kept: an object given only in the options was deleted
    # when the constructor returned, and each write failed with OBJECT-ALREADY-DELETED.
    outputStreamObjectTest() {
        string path = tmp_location() + DirSep + "process-stream-object-" + get_random_string();
        on_exit {
            unlink(path);
            unlink(path + ".err");
        }
        {
            Process p("sh", ("-c", "echo out; echo err >&2"), {
                "stdout": new FileAppendOutputStream(path),
                "stderr": new FileAppendOutputStream(path + ".err"),
            });
            p.wait();
            assertEq("out\n", ReadOnlyFile::readTextFile(path));
            assertEq("err\n", ReadOnlyFile::readTextFile(path + ".err"));
        }
        # the object is also released when the process object is deleted without a wait
        {
            Process p("sh", ("-c", "echo again"), {"stdout": new FileAppendOutputStream(path)});
            delete p;
        }
        assertEq("out\nagain\n", ReadOnlyFile::readTextFile(path));
    }

    # the output of a process started by sandboxed code is written to its output stream on the background I/O thread;
    # the stream runs there under the sandbox of the code that started the process, as it does when that code writes
    # to it itself.  Previously the I/O thread ran without any sandbox, so a stream that the sandbox forbade to write
    # a file wrote it.
    sandboxOutputStreamTest() {
        string denied = tmp_location() + DirSep + "process-sandbox-stream-" + get_random_string();
        mkdir(denied, 0700);
        on_exit {
            unlink(denied + DirSep + "direct.txt");
            unlink(denied + DirSep + "output.txt");
            rmdir(denied);
        }

        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);
        sm.addFilesystemDeniedPath(denied);
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        p.parse("%modern
%requires process
sub write_direct(OutputStream stream) {
    stream.write(binary(\"direct\"));
}
sub run(OutputStream stream) {
    Process proc(\"sh\", (\"-c\", \"echo sandboxed\"), {\"stdout\": stream});
    proc.wait();
}
", "sandbox-stream-test");

        # the stream class is defined in this unrestricted program; called by the sandboxed code, it is governed by
        # the sandbox of its caller
        string direct = denied + DirSep + "direct.txt";
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(),
            ("write_direct", new FileAppendOutputStream(direct)), "the sandboxed code writes to the stream");
        assertFalse(is_file(direct), "the stream did not write the file for the sandboxed code");

        # the same stream given for the output of a process that the sandboxed code starts is written on the I/O
        # thread; the exception raised there is rethrown when the process is waited for
        string output = denied + DirSep + "output.txt";
        *hash<ExceptionInfo> err;
        try {
            p.callFunction("run", new FileAppendOutputStream(output));
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        assertEq("FILESYSTEM-ACCESS-DENIED", err.err, "the output stream was written under the sandbox");
        assertFalse(is_file(output), "the output stream did not write the file outside the sandbox");

        # without a sandbox, the same stream writes the output
        {
            Process proc("sh", ("-c", "echo unrestricted"), {"stdout": new FileAppendOutputStream(output)});
            proc.wait();
        }
        assertEq("unrestricted\n", ReadOnlyFile::readTextFile(output), "the stream wrote the output");
    }

    # run(), pipeline() and getResourceUsage() return the hashdecl types that they are declared with.  Previously they
    # returned untyped hashes, so assigning the result to a variable of the declared type, as in their documentation,
    # raised RUNTIME-TYPE-ERROR.
    resultTypesTest() {
        hash<ProcessResult> r = Process::run("sh", ("-c", "printf out; printf err >&2; exit 3"));
        assertEq("hash<ProcessResult>", r.fullType());
        assertEq(<ProcessResult>{"stdout": "out", "stderr": "err", "exit_code": 3, "ok": True}, r);

        r = Process::pipeline((("echo", "piped"), ("cat",)));
        assertEq("hash<ProcessResult>", r.fullType());
        assertEq("piped\n", r.stdout);

        hash<ResourceUsageInfo> usage = Process::getResourceUsage();
        assertEq("hash<ResourceUsageInfo>", usage.fullType());
        assertTrue(usage.max_rss > 0, "this process uses memory");
        usage = Process::getResourceUsage(getpid());
        assertEq("hash<ResourceUsageInfo>", usage.fullType());

        Process p("sh", ("-c", "exit 0"));
        p.wait();
        usage = p.getResourceUsage();
        assertEq("hash<ResourceUsageInfo>", usage.fullType());
    }

    # the launch callbacks run while process starts are serialized; a callback can start and destroy a process
    # itself.  Previously the lock serializing the starts was not recursive, and the callback waited for itself forever
    # (the test runner's time limit is only a guard).
    callbackProcessTest() {
        list<string> output = ();
        code start = sub (hash<auto> e) {
            Process p("sh", ("-c", sprintf("printf %s", e.name)));
            p.wait();
            output += p.readStdout(100);
        };
        {
            Process p("sh", ("-c", "exit 0"), {"on_setup": start, "on_success": start});
            p.wait();
        }
        assertEq(("on_setup", "on_success"), output);
    }

    # a child process created with fork() while another thread holds the lock that serializes process starts (here in
    # a launch callback) can start processes: the module's fork handler initializes the lock again in the child.
    # Previously the child got the lock held by a thread that does not exist in it, and its first process start
    # waited forever (the test runner's time limit is only a guard).
    forkWhileStartingTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        string result = tmp_location() + DirSep + "process-fork-" + get_random_string();
        on_exit unlink(result);

        Queue in_callback();
        Queue release();
        Counter done(1);
        background sub () {
            on_exit done.dec();
            Process p("sh", ("-c", "exit 0"), {"on_setup": sub (hash<auto> e) {
                in_callback.push(True);
                release.get();
            }});
            p.wait();
        }();
        # the other thread holds the lock while its callback waits
        in_callback.get();
        int pid = fork();
        if (!pid) {
            # the child: only this thread exists
            int rc = 1;
            try {
                Process c("sh", ("-c", "exit 7"));
                c.wait();
                File f();
                f.open2(result, O_CREAT | O_WRONLY | O_TRUNC);
                f.printf("%d", c.exitCode());
                rc = 0;
            } catch (hash<ExceptionInfo> ex) {
                rc = 2;
            }
            exit(rc);
        }
        release.push(True);
        done.waitForZero();
        assertGt(0, pid, "fork() succeeded");
        Process child(pid);
        child.wait();
        assertEq("7", ReadOnlyFile::readTextFile(result), "the child started a process");
    }

    # a Process object made in the parent belongs to the parent: in a child created with fork(), its methods raise
    # PROCESS-FORK-ERROR, deleting it neither waits for the parent's I/O thread nor stops the parent's child, and the
    # child watches the end of its own processes without taking the notifications of the parent.  Previously a wait
    # in the child waited forever for the parent's I/O thread (the test runner's time limit is only a guard), and
    # deleting the object stopped the parent's child process.
    forkInheritedObjectTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        string fifo = makeFifo();
        on_exit unlink(fifo);
        string result = tmp_location() + DirSep + "process-fork-object-" + get_random_string();
        on_exit unlink(result);

        # the parent's child runs until the FIFO is released
        Process p("sh", ("-c", sprintf("cat %s >/dev/null; echo done", fifo)));
        int pid = fork();
        if (!pid) {
            # the child
            string err;
            try {
                p.wait();
                err = "waited";
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            delete p;
            # the child starts and waits for a process of its own
            hash<ProcessResult> r = Process::run("sh", ("-c", "exit 5"));
            File f();
            f.open2(result, O_CREAT | O_WRONLY | O_TRUNC);
            f.printf("%s %d", err, r.exit_code);
            exit(0);
        }
        assertGt(0, pid, "fork() succeeded");
        Process child(pid);
        child.wait();
        assertEq("PROCESS-FORK-ERROR 5", ReadOnlyFile::readTextFile(result), "the object failed in the child");
        assertTrue(p.running(), "the parent's child still runs");
        releaseFifoReader(fifo);
        assertTrue(p.wait());
        assertEq(0, p.exitCode());
        assertEq("done\n", p.readStdout(100));
    }

    # without the env option, a child gets a copy of the environment of this process, read under the environment lock
    # that setenv() and unsetenv() take, and the command is searched in the PATH of this process
    inheritedEnvironmentTest() {
        string name = "QORE_PROCESS_ENV_" + get_random_string();
        on_exit unsetenv(name);

        assertEq(0, setenv(name, "changed with setenv()"));
        hash<ProcessResult> r = Process::run("sh", ("-c", sprintf("printf %%s \"${%s}\"", name)));
        assertEq("changed with setenv()", r.stdout, "the child got the variable set");

        assertEq(0, unsetenv(name));
        r = Process::run("sh", ("-c", sprintf("printf %%s \"${%s-unset}\"", name)));
        assertEq("unset", r.stdout, "the child did not get the variable removed");

        # a command found only in a directory added to the PATH with setenv()
        string dir = tmp_location() + DirSep + "process-env-path-" + get_random_string();
        mkdir(dir, 0700);
        string cmd = "qore-process-env-test-" + get_random_string();
        string cmd_path = dir + DirSep + cmd;
        on_exit {
            unlink(cmd_path);
            rmdir(dir);
        }
        {
            File f();
            f.open2(cmd_path, O_CREAT | O_WRONLY | O_TRUNC, 0700);
            f.write("#!/bin/sh\nprintf found\n");
        }
        string old_path = ENV.PATH;
        on_exit setenv("PATH", old_path);
        assertThrows("PROCESS-SEARCH-PATH-ERROR", sub () { Process p(cmd); });
        assertEq(0, setenv("PATH", dir + ":" + old_path));
        assertEq(cmd_path, Process::searchPath(cmd), "the command was found in the PATH set");
        r = Process::run(cmd);
        assertEq("found", r.stdout, "the command found in the PATH set ran");
    }

    # Process::getEnvironment() returns the current environment, including the changes made with setenv() and
    # unsetenv(), so that a child can be given the current environment with changes; the ENV hash is a copy of the
    # environment made when Qore started, which a child given "ENV + {...}" got instead
    getEnvironmentTest() {
        string name = "QORE_PROCESS_GETENV_" + get_random_string();
        on_exit unsetenv(name);

        hash<string, string> env = Process::getEnvironment();
        assertEq("hash<string, string>", env.fullType());
        assertEq(getenv("PATH"), env.PATH, "the environment has the PATH");
        assertFalse(env.hasKey(name), "the variable is not set yet");

        assertEq(0, setenv(name, "set after startup"));
        env = Process::getEnvironment();
        assertEq("set after startup", env{name}, "the variable set with setenv() is returned");
        assertFalse(ENV.hasKey(name), "ENV is a copy of the environment made when Qore started");

        # a child given the current environment with changes gets both
        string cmd = sprintf("printf '%%s|%%s' \"${%s}\" \"${QORE_PROCESS_ADDED}\"", name);
        hash<ProcessResult> r = Process::run("sh", ("-c", cmd),
            {"env": Process::getEnvironment() + {"QORE_PROCESS_ADDED": "added"}});
        assertEq("set after startup|added", r.stdout, "the child got the current environment with the change");

        assertEq(0, unsetenv(name));
        assertFalse(Process::getEnvironment().hasKey(name), "the variable removed with unsetenv() is not returned");

        # the method is in the external information domain
        Program p(PO_NEW_STYLE | PO_NO_EXTERNAL_INFO);
        assertThrows("PARSE-EXCEPTION", \p.parse(), ("%requires process\nProcess::getEnvironment();",
            "get-environment-test"));
    }

    # threads add, change and remove variables of the environment while children are started, which copies the
    # environment: a change can reallocate the array of the environment and free the strings it replaces, so the
    # copy is made under the environment lock that setenv() and unsetenv() take.  Previously the copy was made
    # without it; the failure (a read of freed memory) is shown by valgrind or a crash, not deterministically.
    environmentChangeTest() {
        string prefix = sprintf("QORE_PROCESS_ENV_CHANGE_%d_", getpid());
        string stable = prefix + "STABLE";
        assertEq(0, setenv(stable, "stable"));
        on_exit unsetenv(stable);

        int writers = 3;
        int children = 20;
        Counter writers_done(writers);
        bool stop;
        Queue errors();
        for (int w = 0; w < writers; ++w) {
            background sub (int w) {
                on_exit writers_done.dec();
                try {
                    for (int i = 0; !stop; ++i) {
                        string name = sprintf("%s%d_%d", prefix, w, i % 50);
                        setenv(name, strmul("v", 64 + i % 64));
                        if (i % 3) {
                            unsetenv(name);
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    errors.push(ex);
                }
            }(w);
        }
        on_exit {
            stop = True;
            writers_done.waitForZero();
            for (int w = 0; w < writers; ++w) {
                for (int i = 0; i < 50; ++i) {
                    unsetenv(sprintf("%s%d_%d", prefix, w, i));
                }
            }
        }

        for (int i = 0; i < children; ++i) {
            hash<ProcessResult> r = Process::run("sh", ("-c", sprintf("printf %%s \"${%s}\"", stable)));
            assertEq("stable", r.stdout, sprintf("child %d got the environment", i));
        }
        stop = True;
        writers_done.waitForZero();
        assertEq(0, errors.size(), "the writers had no errors");
    }

    getExecutablePathTest() {
        if (!HAVE_PROCESS_GETEXECUTABLEPATH) {
            assertThrows("PROCESS-GETEXECUTABLEPATH-UNSUPPORTED-ERROR", \Process::getExecutablePath());
            return;
        }
        # this script runs in the Qore interpreter
        string exe = Process::getExecutablePath();
        assertEq(exe, Process::getExecutablePath(getpid()));
        assertTrue(absolute_path(exe), sprintf("the path is absolute (got %y)", exe));
        assertTrue(is_executable(exe), sprintf("the path is an executable file (got %y)", exe));
        assertThrows("PROCESS-GETEXECUTABLEPATH-ERROR", \Process::getExecutablePath(), -1);
    }

    getSystemMemoryInfoTest() {
        if (!HAVE_PROCESS_GETSYSTEMMEMORYINFO) {
            assertThrows("PROCESS-GETSYSTEMMEMORYINFO-UNSUPPORTED-ERROR", \Process::getSystemMemoryInfo());
            return;
        }
        hash<SystemMemoryInfo> info = Process::getSystemMemoryInfo();
        assertGt(0, info.total, "the system has memory");
        assertGt(0, info.available, "memory is available to this process");
        assertTrue(info.available <= info.total, "no more memory is available than the system has");
        if (exists info.limit) {
            assertGt(0, info.limit);
            assertTrue(info.available <= info.limit, "no more memory is available than the limit");
        }
    }

    releaseFreeMemoryTest() {
        if (HAVE_PROCESS_GETMEMORYINFO) {
            # return what is free before the measurement
            Process::releaseFreeMemory();
            int before = Process::getMemorySummaryInfo().priv;
            {
                # many small allocations, which the allocator keeps after they are freed
                list<string> l = ();
                for (int i = 0; i < 1000000; ++i) {
                    l += sprintf("value %d", i);
                }
                assertEq(1000000, l.size());
            }
            int peak = Process::getMemorySummaryInfo().priv;
            bool released = Process::releaseFreeMemory();
            int after = Process::getMemorySummaryInfo().priv;
            # the GNU C library allocator and jemalloc (Linux) return the freed list at once; the macOS system
            # allocator returns freed memory on its own schedule, so there the call may release nothing
            if (PlatformOS == "Linux") {
                assertTrue(released, "released on Linux");
            }
            if (released) {
                # the list took tens of megabytes; most of it must be returned
                assertGt(after, before + (peak - before) / 2,
                    sprintf("before: %d peak: %d after: %d", before, peak, after));
            }
        }

        # the method is in the process domain
        Program p(PO_NEW_STYLE | PO_NO_PROCESS_CONTROL);
        assertThrows("PARSE-EXCEPTION", \p.parse(), ("%requires process\nProcess::releaseFreeMemory();",
            "release-free-memory-test"));
    }

    getCommandLineTest() {
        if (HAVE_PROCESS_GETCOMMANDLINE) {
            # Test getting command line for current process
            {
                string cmdline = Process::getCommandLine(getpid());
                assertTrue(cmdline.size() > 0, "command line should not be empty");
                # The command line should contain "qore" since we're running a qore script
                assertTrue(cmdline.find("qore") >= 0,
                    sprintf("command line should contain 'qore' (got '%s')", cmdline));
            }

            # Test getting command line for a child process with known arguments
            {
                Process p(getTestValue("testSleep"), (5,), {"path": (m_prefix,)});
                string cmdline = Process::getCommandLine(p.id());
                assertTrue(cmdline.size() > 0, "child command line should not be empty");
                # The command line should contain the test script name
                assertTrue(cmdline.find("test_sleep") >= 0,
                    sprintf("child command line should contain 'test_sleep' (got '%s')", cmdline));
                # The command line should contain the argument "5"
                assertTrue(cmdline.find("5") >= 0,
                    sprintf("child command line should contain argument '5' (got '%s')", cmdline));
                p.terminate();
            }

            # Negative: invalid PID
            assertThrows("PROCESS-GETCOMMANDLINE-ERROR", \Process::getCommandLine(), -1);

            # Negative: nonexistent PID
            assertThrows("PROCESS-GETCOMMANDLINE-ERROR", \Process::getCommandLine(), 999999999);

            # Negative: a kernel thread has an empty /proc/PID/cmdline, which must raise an exception
            # and not crash; only when PID 2 is kthreadd (not in a PID namespace) and not running as
            # root, when the process cannot be signaled and the retry loop ends immediately
            if (Qore::PlatformOS == "Linux" && getuid() && is_file("/proc/2/comm")
                && ReadOnlyFile::readTextFile("/proc/2/comm") == "kthreadd\n") {
                assertEq("", ReadOnlyFile::readTextFile("/proc/2/cmdline"));
                assertThrows("PROCESS-GETCOMMANDLINE-ERROR", \Process::getCommandLine(), 2);
            }
        } else {
            assertThrows("PROCESS-GETCOMMANDLINE-UNSUPPORTED-ERROR", \Process::getCommandLine(), 1);
        }
    }

    getPidsForPortTest() {
        if (HAVE_PROCESS_GETPIDSFORPORT) {
            # Test with a TCP listener on a known port
            {
                Socket s();
                # Bind to an ephemeral port
                s.bind("localhost:0");
                s.listen();
                int port = s.getSocketInfo().port;
                assertTrue(port > 0, sprintf("bind should assign a port (got %d)", port));

                list<int> pids = Process::getPidsForPort(port);
                assertTrue(pids.size() > 0,
                    sprintf("should find at least one PID for port %d (got %y)", port, pids));
                assertTrue(inlist(getpid(), pids),
                    sprintf("current PID %d should be in the list for port %d (got %y)",
                        getpid(), port, pids));
            }

            # Test unused port returns empty list
            {
                # Use a high ephemeral port that's very unlikely to be in use
                list<int> pids = Process::getPidsForPort(59999);
                # This might not be empty if something is actually listening, so just check type
                assertTrue(exists pids, "should return a list");
            }

            # Negative: invalid port 0
            assertThrows("PROCESS-GETPIDSFORPORT-ERROR", \Process::getPidsForPort(), 0);

            # Negative: invalid port -1
            assertThrows("PROCESS-GETPIDSFORPORT-ERROR", \Process::getPidsForPort(), -1);

            # Negative: invalid port > 65535
            assertThrows("PROCESS-GETPIDSFORPORT-ERROR", \Process::getPidsForPort(), 99999);
        } else {
            assertThrows("PROCESS-GETPIDSFORPORT-UNSUPPORTED-ERROR", \Process::getPidsForPort(), 80);
        }
    }

    #! A child is not started with the caller's blocked signals or its ignored SIGPIPE
    /** Qore blocks signals in its threads and ignores SIGPIPE; a child that inherited that state could not be
        stopped with SIGTERM and would not end on SIGPIPE.  Each shell sends the signal to itself and prints
        "alive" only if the signal did not end it.
    */
    childSignalStateTest() {
        foreach string sig in (("TERM", "PIPE")) {
            MyOutputStream out();
            Process p("/bin/sh", ("-c", sprintf("kill -%s $$; echo alive", sig)), {"stdout": out});
            assertTrue(p.wait(30s), sprintf("SIG%s: the child ends", sig));
            assertEq("", out.buf ?? "", sprintf("SIG%s ends the child before it prints", sig));
            assertNeq(0, p.exitCode(), sprintf("SIG%s: the child does not report success", sig));
        }
    }

    getPidsForUnixSocketTest() {
        if (HAVE_PROCESS_GETPIDSFORUNIXSOCKET) {
            # Test with a Unix domain socket listener
            {
                string sock_path = tmp_location() + DirSep + "process_test_" + get_random_string() + ".sock";
                on_exit {
                    try { unlink(sock_path); } catch () {}
                }

                Socket s();
                s.bindUNIX(sock_path, SOCK_STREAM);
                s.listen();

                list<int> pids = Process::getPidsForUnixSocket(sock_path);
                assertTrue(pids.size() > 0,
                    sprintf("should find at least one PID for socket %s (got %y)", sock_path, pids));
                assertTrue(inlist(getpid(), pids),
                    sprintf("current PID %d should be in the list for socket %s (got %y)",
                        getpid(), sock_path, pids));
            }

            # Test non-existent socket path returns empty list
            {
                list<int> pids = Process::getPidsForUnixSocket("/tmp/nonexistent_socket_path_12345.sock");
                assertEq(0, pids.size(), "non-existent socket should return empty list");
            }

            # Negative: empty path
            assertThrows("PROCESS-GETPIDSFORUNIXSOCKET-ERROR", \Process::getPidsForUnixSocket(), "");
        } else {
            assertThrows("PROCESS-GETPIDSFORUNIXSOCKET-UNSUPPORTED-ERROR",
                \Process::getPidsForUnixSocket(), "/tmp/test.sock");
        }
    }
}

sub run_bg(Counter cnt, Process p, Main m) {
    m.assertTrue(p.id() > 0, "PID must be given");
    m.assertTrue(p.valid(), "process must be valid");
    m.assertTrue(p.running(), "process must be running");

    cnt.dec();
    p.wait();
    m.assertFalse(p.running(), "process must not be running");
}

sub executor_func(hash<auto> e) {
    if (VERBOSE > 2) printf("executor_func: %y\n", e);
    MAIN.assertEq("on_success", e.name, "name check");
    MAIN.assertEq(MAIN.prefix() + MAIN.getTestValue("testTrue"), e.exe, "on_success exe check");
    MAIN.assertNothing(e.error_code, "on_success error_code check");
}
