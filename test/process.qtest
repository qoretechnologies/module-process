            p.wait();
            fail();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("PROCESS-SEARCH-PATH-ERROR", ex.err, "ex.err check");
            assertEq("Command 'test_true.q' cannot be found in PATH", ex.desc, "ex.desc check");
        }
    }

    detachTest() {
        int pid;
        {
            Process p(getTestValue("testSleep"), 100, ("path" : (m_prefix,)));
            pid = p.id();
            p.detach();
            assertTrue(p.running(), "Detached process is running");
            assertEq(pid, p.id(), "Detached process has the same PID");
        }

        {
            Process p(pid);
            assertTrue(p.running(), "Detached process is still running");
            p.terminate();
            assertFalse(p.running(), "Detached process is not running");
            p.wait();
            assertFalse(p.running(), "Detached process is not running");
            p.detach();
        }

        {
            Process p(getTestValue("testSleep"), 1, {"path": (m_prefix,)});
            p.detach();
            assertTrue(p.running(), "Detached process is running");
            assertTrue(p.wait(), "wait() on detached process");
        }
    }

    detachTestNegative() {
        int pid;
        {
            Process p(getTestValue("testSleep"), 5, ("path" : (m_prefix,)));
            pid = p.id();
        }

        assertFalse(Process::checkPid(pid), sprintf("Process with pid %d should not be running", pid));
        assertThrows("PROCESS-CONSTRUCTOR-ERROR", sub () {
            Process p(pid);
        });
    }

    detachedProcessIOTest() {
        Process p(getTestValue("testSleep"), 5, ("path": (m_prefix,)));
        p.detach();
        assertTrue(p.running(), "Detached process is running");

        assertEq(NOTHING, p.readStdout(1000));
        assertEq(NOTHING, p.readStderr(1000));
        assertEq(NOTHING, p.readStdout(1000, 200));
        assertEq(NOTHING, p.readStderr(1000, 200));

        p.write("lorem ipsum"); # shouldn't throw
    }

    waitTimeoutTest() {
        Process p(getTestValue("testSleep"), 3, ("path" : (m_prefix,)));
        assertFalse(p.wait(1s));
        assertTrue(p.wait(5s));
        assertTrue(p.wait());
        assertEq(0, p.exitCode(), "process exit code");
    }

    memoryAndCheckPidTest() {
        if (HAVE_PROCESS_GETMEMORYINFO) {
            hash<auto> h = Process::getMemorySummaryInfo();
            assertGt(0, h.vsz);
            assertGt(0, h.rss);
            assertGt(0, h.priv);
            assertEq("hash<MemorySummaryInfo>", h.fullType());
            assertThrows("PROCESS-GETMEMORYINFO-ERROR", \Process::getMemorySummaryInfo(), -10);
        } else {
            assertThrows("PROCESS-GETMEMORYINFO-UNSUPPORTED-ERROR", \Process::getMemorySummaryInfo(), -10);
        }

        if (HAVE_PROCESS_CHECKPID) {
            assertTrue(Process::checkPid(getpid()));
        } else {
            assertThrows("PROCESS-CHECKPID-UNSUPPORTED-ERROR", \Process::checkPid(), -10);
        }
    }

    # while the background I/O thread of a process waits for its end, it alone reaps the child: Process::wait(),
    # Process::running() and Process::terminate() wait for its report or check the child without reaping it.
    # Previously they reaped the child themselves, racing with the I/O thread (a data race on the exit status reported
    # by ThreadSanitizer in Process::wait()), and terminate() could report 128 + SIGKILL instead of SIGKILL.
    endReportTest() {
        for (int i = 0; i < 20; ++i) {
            Process p(getTestValue("testSleep"), 5, {"path": (m_prefix,)});
            assertTrue(p.running(), "the process runs");
            p.terminate();
            assertFalse(p.running(), "the process has ended");
            assertEq(SIGKILL, p.exitCode(), "the exit code of a killed process");
            p.wait();
            assertEq(SIGKILL, p.exitCode(), "the exit code after the wait");
        }
        for (int i = 0; i < 20; ++i) {
            Process p("sh", ("-c", "exit 3"));
            p.wait();
            assertFalse(p.running(), "the process has ended");
            assertEq(3, p.exitCode(), "the exit code of the process");
        }
    }

    terminateTest() {
        Process p("tee");
        assertTrue(p.running());
        int pid = p.id();
        Process::terminate(pid);
        # we do not have to call Process::waitForTermination() here because we are terminating a child process
        # and terminate calls waitpid() on Unix platforms
        assertFalse(p.running());
        if (HAVE_PROCESS_CHECKPID) {
            assertFalse(Process::checkPid(pid));
        }

        # negative test for Process::terminate() with an invalid PID
        assertThrows("PROCESS-INVALID-PID", \Process::terminate(), 9999999);

        if (HAVE_PROCESS_WAITFORTERMINATION) {
            # negative test for Process::waitForTermination() with an invalid PID
            assertNothing(Process::waitForTermination(9999999));
        } else {
            assertThrows("PROCESS-WAITFORTERMINATION-UNSUPPORTED-ERROR", \Process::waitForTermination(), -10);
        }
    }

    zombieDetectionTest() {
        if (!HAVE_PROCESS_CHECKPID) {
            testSkip("checkPid not available on this platform");
        }
        if (Qore::PlatformOS !~ /Linux|Darwin|FreeBSD|DragonFly|NetBSD|OpenBSD/) {
            testSkip("zombie detection not implemented on this platform");
        }
        if (!Process::commandExists("python3")) {
            testSkip("python3 not available (needed to create zombie via fork())");
        }

        # Use Python's os.fork() to reliably create a zombie process
        # The parent forks a child that exits immediately, then sleeps without calling wait()
        string script = tmp_location() + DirSep + "zombie_creator.py";
        {
            File f();
            f.open(script, O_CREAT|O_WRONLY|O_TRUNC, 0755);
            f.write(
                "#!/usr/bin/env python3\n"
                "import os, time, sys\n"
                "pid = os.fork()\n"
                "if pid == 0:\n"
                "    os._exit(0)\n"
                "print(pid, flush=True)\n"
                "time.sleep(300)\n"
            );
        }

        Process p("python3", (script,));

        # Read the child PID from stdout
        string child_pid_str;
        int retries = 100;
        while (retries > 0) {
            *string s = p.readStdout(100);
            if (s) {
                child_pid_str += s;
                if (child_pid_str.find("\n") >= 0) {
                    break;
                }
            }
            usleep(50ms);
            --retries;
        }
        int child_pid = trim(child_pid_str).toInt();
        assertTrue(child_pid > 0, sprintf("child PID should be positive (got %d)", child_pid));

        # Wait for the child to exit and become a zombie
        sleep(500ms);

        # Verify the process is actually a zombie
        if (Qore::PlatformOS == "Linux") {
            # On Linux, verify via /proc
            string stat_path = sprintf("/proc/%d/stat", child_pid);
            assertTrue(is_file(stat_path), sprintf("zombie /proc/%d/stat should exist", child_pid));
        } else {
            # On macOS/*BSD, verify via ps
            Process ps("ps", ("-o", "state=", "-p", string(child_pid)));
            string state;
            retries = 20;
            while (retries > 0) {
                *string s = ps.readStdout(100);
                if (s) {
                    state += s;
                }
                if (!ps.running()) {
                    break;
                }
                usleep(50ms);
                --retries;
            }
            state = trim(state);
            assertTrue(state.size() > 0 && state[0] == "Z",
                sprintf("ps should report zombie state (got '%s') for PID %d", state, child_pid));
        }

        # checkPid should return false for zombie processes
        assertFalse(Process::checkPid(child_pid),
            sprintf("checkPid should return false for zombie process (PID %d)", child_pid));

        # Clean up
        p.terminate();
        unlink(script);
    }

