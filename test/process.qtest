    waitUnwatchedProcessTest() {
        # the end of a detached process and of one attached by its PID is not reported by the background handler; a
        # wait returned at once, as if the process had ended, while it still ran
        int short_ms = 300;
        int max_ms = 10000;

        # a detached child
        {
            Process p("sh", ("-c", "sleep 3"));
            p.detach();
            int start = clock_get_monotonic_us();
            assertFalse(p.wait(short_ms), "a timed wait on a running detached process");
            int ms = (clock_get_monotonic_us() - start) / 1000;
            assertTrue(ms >= short_ms - 10, sprintf("the timed wait returned after %d ms", ms));
            assertTrue(p.running(), "the detached process still runs");
            start = clock_get_monotonic_us();
            assertTrue(p.wait(max_ms), "a timed wait on a detached process that ends");
            ms = (clock_get_monotonic_us() - start) / 1000;
            assertTrue(ms < max_ms - 1000, sprintf("the timed wait returned after %d ms", ms));
            assertFalse(p.running(), "the detached process has ended");
            assertEq(0, p.exitCode(), "the exit code of the detached process");
        }

        # a process attached by its PID that is not a child of this process: the shell exits at once, and its child
        # is reparented
        {
            Process sh("sh", ("-c", "sleep 3 >/dev/null 2>&1 & echo $!"));
            sh.wait();
            int pid = sh.readStdout(100).toInt();
            assertTrue(Process::checkPid(pid), "the reparented process runs");
            Process p(pid);
            int start = clock_get_monotonic_us();
            assertFalse(p.wait(short_ms), "a timed wait on a running process attached by its PID");
            int ms = (clock_get_monotonic_us() - start) / 1000;
            assertTrue(ms >= short_ms - 10, sprintf("the timed wait returned after %d ms", ms));
            assertTrue(p.running(), "the attached process still runs");
            start = clock_get_monotonic_us();
            assertTrue(p.wait(), "a wait on a process attached by its PID");
            ms = (clock_get_monotonic_us() - start) / 1000;
            assertTrue(ms >= 1000 && ms < max_ms, sprintf("the wait returned after %d ms", ms));
            assertFalse(Process::checkPid(pid), "the attached process has ended");
        }
    }

    detachedProcessTrackingTest() {
        string fifo = makeFifo();
        on_exit unlink(fifo);

        # a second detach() took the PID of the released handle, -1, and the process was then checked and waited for
        # as any child of this process
        {
            Process p("sh", ("-c", sprintf("cat %s >/dev/null; exit 3", fifo)));
            int pid = p.id();
            p.detach();
            p.detach();
            assertEq(pid, p.id(), "a process detached twice keeps its PID");
            assertTrue(p.running(), "a process detached twice runs");
            assertFalse(p.wait(0), "a timed wait on a running detached process");
            releaseFifoReader(fifo);
            assertTrue(p.wait(), "a wait on a detached process that ends");
            assertFalse(p.running(), "the detached process has ended");
            assertEq(3, p.exitCode(), "the exit code of a detached process");
        }

        # a detached process ended by a signal reported 0 as its exit code; it reports what a process that is not
        # detached reports: the signal
        {
            # each reads its standard input, which stays open
            Process attached("cat");
            Process detached("cat");
            detached.detach();
            assertEq(0, kill(attached.id(), SIGKILL));
            assertEq(0, kill(detached.id(), SIGKILL));
            assertTrue(attached.wait(), "a wait on a killed process");
            assertTrue(detached.wait(), "a wait on a killed detached process");
            assertEq(SIGKILL, attached.exitCode(), "the exit code of a killed process");
            assertEq(attached.exitCode(), detached.exitCode(), "the exit code of a killed detached process");
        }

        # a detached process attached by its PID that is not a child of this process was reported ended at once
        {
            int pid = startReparentedReader(fifo);
            Process p(pid);
            p.detach();
            assertTrue(p.running(), "a detached process attached by its PID runs");
            assertFalse(p.wait(0), "a timed wait on a running detached process attached by its PID");
            releaseFifoReader(fifo);
            assertTrue(p.wait(), "a wait on a detached process attached by its PID that ends");
            assertFalse(p.running(), "the detached process attached by its PID has ended");
        }
    }

    waitUnwatchedCancelTest() {
        string fifo = makeFifo();
        on_exit unlink(fifo);

        # a detached child of this process
        {
            Process p("sh", ("-c", sprintf("cat %s >/dev/null", fifo)));
            p.detach();
            hash<auto> rv = cancelBlockedWait(p, -1);
            assertEq("THREAD-CANCELLED", rv.err, "a wait on a detached process ends with the cancellation");
            rv = cancelBlockedWait(p, 3600000);
            assertEq("THREAD-CANCELLED", rv.err, "a timed wait on a detached process ends with the cancellation");
            assertTrue(p.running(), "the detached process runs after the cancelled waits");
            releaseFifoReader(fifo);
            assertTrue(p.wait(), "a wait on the detached process after the cancelled waits");
        }

        # a process attached by its PID that is not a child of this process
        {
            int pid = startReparentedReader(fifo);
            Process p(pid);
            hash<auto> rv = cancelBlockedWait(p, -1);
            assertEq("THREAD-CANCELLED", rv.err, "a wait on an attached process ends with the cancellation");
            rv = cancelBlockedWait(p, 3600000);
            assertEq("THREAD-CANCELLED", rv.err, "a timed wait on an attached process ends with the cancellation");
            assertTrue(p.running(), "the attached process runs after the cancelled waits");
            releaseFifoReader(fifo);
            assertTrue(p.wait(), "a wait on the attached process after the cancelled waits");
            assertFalse(Process::checkPid(pid), "the attached process has ended");
        }
    }

    outputFileOwnershipTest() {
        string path = tmp_location() + DirSep + get_random_string();
        File f();
        f.open2(path, O_WRONLY | O_TRUNC | O_CREAT | O_APPEND);
        on_exit try {
            unlink(path);
        } catch () {}

        *int fds = HAVE_PROCESS_GETDESCRIPTORCOUNT ? Process::getDescriptorCount() : NOTHING;
        # one File for both outputs, as for a log file
        {
            Process p("sh", ("-c", "echo out; echo err >&2"), {"stdout": f, "stderr": f});
            assertTrue(f.isOpen(), "the File given stays open");
            assertTrue(p.wait(), "the process ends");
        }
        if (fds) {
            assertEq(fds, Process::getDescriptorCount(), "no descriptor is left open by the redirection");
        }
        f.write("after\n");
        f.close();
        assertEq("out\nerr\nafter\n", ReadOnlyFile::readTextFile(path), "the output of both streams and the "
            "caller's own write");

        # a valid stdout File and an invalid stderr option leave no descriptor open
        f.open2(path, O_WRONLY | O_TRUNC);
        if (fds) {
            fds = Process::getDescriptorCount();
        }
        assertThrows("PROCESS-OPTION-ERROR", sub () { Process p("sh", ("-c", "true"), {"stdout": f, "stderr": 2}); });
        if (fds) {
            assertEq(fds, Process::getDescriptorCount(), "no descriptor is left open by a failed redirection");
        }
        assertTrue(f.isOpen(), "the File given stays open after a failed redirection");
        f.close();
    }

    #! Creates a FIFO in the temporary directory and returns its path
    private string makeFifo() {
        string fifo = tmp_location() + DirSep + get_random_string();
        assertEq(0, mkfifo(fifo), "the FIFO is created");
        return fifo;
    }

    #! Opens the given FIFO for writing and closes it, so that a process reading it reaches its end
    /** The open waits for the reader to open the FIFO, so the reader is released whether or not it has started reading
    */
    private releaseFifoReader(string fifo) {
        File w();
        w.open2(fifo, O_WRONLY);
        w.close();
    }

    #! Starts a process that reads the given FIFO to its end and is not a child of this process
    /** The shell that starts it exits at once, so the process is reparented

        @return the PID of the process
    */
    private int startReparentedReader(string fifo) {
        Process sh("sh", ("-c", sprintf("cat %s >/dev/null 2>&1 & echo $!", fifo)));
        sh.wait();
        int pid = sh.readStdout(100).toInt();
        assertTrue(Process::checkPid(pid), "the reparented reader runs");
        return pid;
    }

    #! Waits on a process in a new thread, cancels the thread once it has started, and returns the error of the wait
    private hash<auto> cancelBlockedWait(Process p, int timeout_ms) {
        Queue started();
        Queue done();
        int tid = background sub () {
            hash<auto> rv;
            try {
                started.push(True);
                if (timeout_ms < 0) {
                    p.wait();
                } else {
                    p.wait(timeout_ms);
                }
                rv.err = "NONE";
            } catch (hash<ExceptionInfo> ex) {
                rv.err = ex.err;
            }
            done.push(rv);
        }();
        started.get();
        cancel_thread(tid, "process wait test");
        return done.get();
    }

    timedReadEndsWithOutputTest() {
        # the timeout is long, so that a read that waits for it is told apart from one that returns when the output
        # ends, which takes a small fraction of it
        timeout long_wait = 20s;
        int max_ms = 10000;

        # the child has written all of its output and exited: each read method returns NOTHING at once
        {
            Process p("sh", ("-c", "printf out; printf err >&2"));
            p.wait();
            assertEq("out", p.readStdout(100, long_wait));
            assertEq("err", p.readStderr(100, long_wait));
            hash<string, code> reads = {
                "readStdout": auto sub () { return p.readStdout(100, long_wait); },
                "readStderr": auto sub () { return p.readStderr(100, long_wait); },
                "readStdoutBinary": auto sub () { return p.readStdoutBinary(100, long_wait); },
                "readStderrBinary": auto sub () { return p.readStderrBinary(100, long_wait); },
            };
            foreach hash<auto> i in (reads.pairIterator()) {
                int start = clock_get_monotonic_us();
                assertNothing(i.value(), i.key);
                int ms = (clock_get_monotonic_us() - start) / 1000;
                assertTrue(ms < max_ms, sprintf("%s returned after %d ms", i.key, ms));
            }
        }

        # the child has closed its standard output but still runs: a read returns when the output ends
        {
            Process p("sh", ("-c", "printf out; exec 1>&-; read x"));
            assertEq("out", p.readStdout(100, long_wait));
            int start = clock_get_monotonic_us();
            assertNothing(p.readStdout(100, long_wait));
            int ms = (clock_get_monotonic_us() - start) / 1000;
            assertTrue(ms < max_ms, sprintf("readStdout returned after %d ms", ms));
            # the child waits for a line on its standard input
            assertTrue(p.running());
            p.write("\n");
            p.closeStdin();
            p.wait();
        }

        # standard output redirected to a file is never read
        {
            string path = tmp_location() + DirSep + get_random_string();
            File f();
            f.open2(path, O_WRONLY | O_TRUNC | O_CREAT);
            on_exit try {
                unlink(path);
            } catch () {}
            Process p("sh", ("-c", "printf out"), {"stdout": f});
            f.close();
            int start = clock_get_monotonic_us();
            assertNothing(p.readStdout(100, long_wait));
            int ms = (clock_get_monotonic_us() - start) / 1000;
            assertTrue(ms < max_ms, sprintf("readStdout returned after %d ms", ms));
            p.wait();
        }
    }

    outputRedirectNegativeTest() {
        EmptyClass obj();
        assertThrows("PROCESS-OPTION-ERROR", sub() { Process p("test", {"stdout": 2}); p.wait(); });
        assertThrows("PROCESS-OPTION-ERROR", sub() { Process p("test", {"stdout": new File()}); p.wait(); });

        assertThrows("PROCESS-OPTION-ERROR", sub() { Process p("test", {"stderr": 2}); p.wait(); });
        assertThrows("PROCESS-OPTION-ERROR", sub() { Process p("test", {"stderr": new File()}); p.wait(); });

        assertThrows("PROCESS-OPTION-ERROR", "stdout.*EmptyClass", sub () { Process p("test", {"stdout": obj}); });
        assertThrows("PROCESS-OPTION-ERROR", "stderr.*EmptyClass", sub () { Process p("test", {"stderr": obj}); });

        File f0();
        File f1 = f0;
        delete f1;
        assertThrows("OBJECT-ALREADY-DELETED", "stdout.*File", sub () { Process p("test", {"stdout": f0}); });
        assertThrows("OBJECT-ALREADY-DELETED", "stderr.*File", sub () { Process p("test", {"stderr": f0}); });

        assertThrows("PROCESS-OPTION-ERROR", "stdout.*File", sub () { Process p("test", {"stdout": NOTHING}); });
        assertThrows("PROCESS-OPTION-ERROR", "stderr.*File", sub () { Process p("test", {"stderr": NOTHING}); });
    }

