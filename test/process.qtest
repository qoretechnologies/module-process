#!/usr/bin/env qore

%modern

%requires process
%requires QUnit
%requires Util

%exec-class Main

# to be used in static methods and separate functions
our *softbool VERBOSE;
our Main MAIN;

bool sub isAlpine() {
    return (ENV.MACHTYPE ?? "").find("alpine") > -1;
}

class EmptyClass {
    constructor() {}
}

class MyOutputStream inherits OutputStream {
    public {
        string buf;
    }

    write(binary bin) {
        buf += bin.toString();
    }

    close() {
    }
}

#! an output stream whose writes fail
class ThrowingOutputStream inherits OutputStream {
    write(binary bin) {
        throw "STREAM-TEST-ERROR", "write refused";
    }

    close() {
    }
}

#! an output stream that appends what is written to a file; defined in the unrestricted test program
class FileAppendOutputStream inherits OutputStream {
    private {
        string path;
    }

    constructor(string path) {
        self.path = path;
    }

    write(binary bin) {
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_APPEND);
        f.write(bin);
    }

    close() {
    }
}

public class Main inherits QUnit::Test {
    private {
        # prefix to find other test scripts
        string m_prefix;

        hash<auto> m_test_paths = (
            "DEFAULT": {
                "testTrue": "test_true.q",
                "testFalse": "test_false.q",
                "testSleep": "test_sleep.q",
                "testOutput": "test_output.q",
            },
            "LINUX": {
                "searchPathTest_in": "ls",
                "searchPathTest_out": "^(/usr)?/bin/ls$",
                "simpleTest_exe": "ls",
                "simpleTest_arg": ("-l", "-s",),
            },
            "WINDOWS": {
                "searchPathTest_in": "timeout",
            },
            "DARWIN": {
                "searchPathTest_in": "hostname",
                "searchPathTest_out": "^(/usr)?/bin/hostname$",
                "simpleTest_exe": "ls",
                "simpleTest_arg": ("-l", "-s",),
            },
        );
    }

    constructor() : Test("Process", "1.0") {
        VERBOSE = m_options.verbose;
        MAIN = self;

        # expand relative path to a fully qualified one
        Dir d();
        d.chdir(get_script_dir());
        m_prefix = d.path() + DirSep;

        addTestCase("descriptor count", \getDescriptorCountTest());
        addTestCase("wait dead", \waitDeadTest());
        addTestCase("output stream", \outputStreamTest());
        addTestCase("no cwd", \noCwdTest());
        addTestCase("SearchPath test", \searchPathTest());
        addTestCase("Absolute test", \absoluteTest());
        addTestCase("loadavg test", \loadAvgTest());
        addTestCase("Constructor test", \constructorTest());
        addTestCase("Named argument calls", \namedArgumentTest());
        addTestCase("Simple test", \simpleTest());
        addTestCase("Single test negative", \simpleTestNegative());
        addTestCase("IO test", \ioTest());
        addTestCase("Dead process IO test", \deadProcessIOTest());
        addTestCase("Executor events test: closure", \executorsTest());
        addTestCase("Executor events test: refs", \executorsRefsTest());
        addTestCase("Executor negative test", \executorsNegativeTest());
        addTestCase("Thread test", \threadTest());
        addTestCase("Env vars test", \envVarsTest());
        addTestCase("Env var negative test", \envVarsNegativeTest());
        addTestCase("Working dir test", \cwdTest());
        addTestCase("Custom PATH test negative", \pathTestNegative());
        addTestCase("Detach test", \detachTest());
        addTestCase("Detach test negative", \detachTestNegative());
        addTestCase("Detached process IO test", \detachedProcessIOTest());
        addTestCase("Wait timeout test", \waitTimeoutTest());
        addTestCase("Mem and checkPid test", \memoryAndCheckPidTest());
        addTestCase("Terminate test", \terminateTest());
        addTestCase("Zombie detection test", \zombieDetectionTest());
        addTestCase("Output redirect test", \outputRedirectTest());
        addTestCase("Output redirect negative test", \outputRedirectNegativeTest());
        addTestCase("Output redirect normal read test", \outputRedirectReadTest());
        addTestCase("closeStdin test", \closeStdinTest());
        addTestCase("sendSignal test", \sendSignalTest());
        addTestCase("Edge case tests", \edgeCaseTests());
        addTestCase("Negative tests", \negativeTests());
        addTestCase("Large I/O test", \largeIOTest());
        addTestCase("Special characters test", \specialCharsTest());
        addTestCase("Binary with NUL test", \binaryNulTest());
        addTestCase("Process::run() test", \runTest());
        addTestCase("Process::commandExists() test", \commandExistsTest());
        addTestCase("Shell option test", \shellOptionTest());
        addTestCase("Nice option test", \niceOptionTest());
        addTestCase("Resource usage test", \resourceUsageTest());
        addTestCase("Child PIDs test", \childPidsTest());
        addTestCase("Invalid process tests", \invalidProcessTests());
        addTestCase("Terminate tree test", \terminateTreeTest());
        addTestCase("Pipeline test", \pipelineTest());
        addTestCase("Resource limits test", \resourceLimitsTest());
        addTestCase("getCommandLine test", \getCommandLineTest());
        addTestCase("repeated run() test", \repeatedRunTest());
        addTestCase("sandbox test", \sandboxTest());
        addTestCase("getExecutablePath test", \getExecutablePathTest());
        addTestCase("getSystemMemoryInfo test", \getSystemMemoryInfoTest());
        addTestCase("releaseFreeMemory test", \releaseFreeMemoryTest());
        addTestCase("getPidsForPort test", \getPidsForPortTest());
        addTestCase("getPidsForUnixSocket test", \getPidsForUnixSocketTest());
        addTestCase("a child starts with the default signal state", \childSignalStateTest());
        addTestCase("a timed read ends with the output", \timedReadEndsWithOutputTest());
        addTestCase("a wait returns when a detached or attached process ends", \waitUnwatchedProcessTest());
        addTestCase("a detached process is tracked by its own PID", \detachedProcessTrackingTest());
        addTestCase("a wait on a detached or attached process ends with a cancellation", \waitUnwatchedCancelTest());
        addTestCase("an output File stays open and owned by the caller", \outputFileOwnershipTest());
        addTestCase("an exception of an output stream is rethrown by wait()", \outputStreamExceptionTest());
        addTestCase("an output stream object given only in the options is written", \outputStreamObjectTest());
        addTestCase("an output stream is written under the sandbox of the code that started the process",
            \sandboxOutputStreamTest());
        addTestCase("results have their documented types", \resultTypesTest());
        addTestCase("a launch callback can start a process", \callbackProcessTest());
        addTestCase("a child created while another thread starts a process can start processes",
            \forkWhileStartingTest());
        addTestCase("a Process object of the parent cannot be used in a child created with fork()",
            \forkInheritedObjectTest());
        addTestCase("a child gets the environment changed with setenv()", \inheritedEnvironmentTest());
        addTestCase("Process::getEnvironment() returns the current environment", \getEnvironmentTest());
        addTestCase("the environment is copied consistently while other threads change it",
            \environmentChangeTest());
        addTestCase("the end of a process is reported by its I/O thread", \endReportTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    getDescriptorCountTest() {
        if (HAVE_PROCESS_GETDESCRIPTORCOUNT) {
            assertGt(0, Process::getDescriptorCount(getpid()), "getDescriptorCount for current process");
            assertGt(0, Process::getDescriptorCount(), "getDescriptorCount for current process");
        } else {
            assertThrows("PROCESS-GETDESCRIPTORCOUNT-UNSUPPORTED-ERROR", \Process::getDescriptorCount(), -10);
        }
    }

    waitDeadTest() {
        Process p(getTestValue("testSleep"), 10000, {"path" : (m_prefix,)});
        sleep(1);
        assertEq(0, kill(p.id(), SIGKILL));
        p.wait();
        assertFalse(p.running(), "process should not be running after wait");
    }

    outputStreamTest() {
        {
            StringOutputStream out();
            StringOutputStream err();

            Process p(
                getTestValue("testOutput"),
                {
                    "path": (m_prefix,),
                    "stdout": out,
                    "stderr": err,
                }
            );

            assertThrows("PROCESS-STREAM-ERROR", \p.readStdout(), 1);
            assertThrows("PROCESS-STREAM-ERROR", \p.readStderr(), 1);

            p.wait();

            assertEq("stdout", out.getData());
            assertEq("stderr", err.getData());
        }

        {
            MyOutputStream out();
            MyOutputStream err();

            Process p(
                getTestValue("testOutput"),
                {
                    "path": (m_prefix,),
                    "stdout": out,
                    "stderr": err,
                }
            );

            assertThrows("PROCESS-STREAM-ERROR", \p.readStdout(), 1);
            assertThrows("PROCESS-STREAM-ERROR", \p.readStderr(), 1);

            p.wait();

            # MyOutputStream is thread safe and can be read at any time
            assertEq("stdout", out.buf);
            assertEq("stderr", err.buf);
        }
    }

    noCwdTest() {
        *string cwd = getcwd();
        string dir = tmp_location() + "/" + get_random_string();
        mkdir(dir);
        chdir(dir);
        rmdir(dir);
        # issue #3254: this will crash without the fix
        assertThrows("PROCESS-DIRECTORY-ERROR", sub () {Process p("ls");});
        chdir(cwd ?? "..");
    }

    string prefix() {
        return m_prefix;
    }

    #! returns True if an element of PATH is the directory of this script (an empty element is the current directory)
    bool scriptDirInPath() {
        string dir = normalize_dir(get_script_dir());
        foreach string elem in ((getenv("PATH") ?? "").split(":")) {
            if (normalize_dir(elem == "" ? "." : elem) == dir) {
                return True;
            }
        }
        return False;
    }

    auto getTestValue(string key) {
        string os = Qore::PlatformOS.upr();
        if (!m_test_paths.hasKey(os)) {
            throw "MISSING-TEST-SETUP", sprintf("There is no TEST_PATHS setup for OS: %s, known OSes: %y", os, m_test_paths.keys());
        }

        if (!m_test_paths.DEFAULT.hasKey(key) && !m_test_paths{os}.hasKey(key)) {
            throw "MISSING-TEST-SETUP", sprintf("There is no TEST_PATHS setup for OS: %s, test_name: %s", os, key);
        }

        return m_test_paths{os}{key} ?? m_test_paths.DEFAULT{key};
    }

    loadAvgTest() {
        list<float> l = Process::getLoadAvg();
        assertEq(3, l.size());
        assertEq(Type::Float, l[0].type());
        assertEq(Type::Float, l[1].type());
        assertEq(Type::Float, l[2].type());
    }

    globalSetUp() {
    }

    globalTearDown() {
    }

    searchPathTest() {
        auto s = Process::searchPath(getTestValue("searchPathTest_in"));
        assertRegex(getTestValue("searchPathTest_out"), s, sprintf("searchPath for %s", getTestValue("searchPathTest_in")));

        try {
            Process::searchPath("some-not-existing-exec");
            fail();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("PROCESS-SEARCH-PATH-ERROR", ex.err, "some-not-existing-exec for searchPath");
        }
    }

    absoluteTest() {
        string path = normalize_dir(get_script_dir() + DirSep + "test_true.q");
        Process proc(path);
        proc.wait();
        assertEq(0, proc.exitCode());

        # negative tests
        path = "abc" + DirSep + "test_true.q";
        assertThrows("PROCESS-SEARCH-PATH-ERROR", sub () { proc = new Process(path, ("path": ())); });
        path = "test_true.q";
        # the scripts of this directory are found in PATH if PATH includes the directory (ex: "." while it is the
        # current directory)
        if (scriptDirInPath()) {
            proc = new Process(path);
            proc.wait();
            assertEq(0, proc.exitCode(), "test_true.q is found in PATH, which includes its directory");
        } else {
            assertThrows("PROCESS-SEARCH-PATH-ERROR", sub () { proc = new Process(path); });
        }
        path = DirSep + "test_true.q";
        assertThrows("PROCESS-CONSTRUCTOR-ERROR", sub () { proc = new Process(path, ("path": ())); });
    }

    constructorTest() {
        hash<auto> opts = {
            "path": (m_prefix,),
            "env": {"FOO": "bar"} + ENV,
        };

        string exe = getTestValue("testTrue");
        softlist args = ( 1, );

        # the scripts of this directory are found in PATH if PATH includes the directory
        if (scriptDirInPath()) {
            Process p1(exe);
            p1.wait();
            assertEq(0, p1.exitCode(), "it is found in PATH, which includes its directory");
        } else {
            try {
                Process p1(exe);
                p1.wait();
                fail();
            } catch (hash<ExceptionInfo> ex) {
                assertEq("PROCESS-SEARCH-PATH-ERROR", ex.err, "it should not be found");
            }
        }

        Process p2(exe, args, opts);
        p2.wait();
        assertEq(0, p2.exitCode(), "exit code p2");

        Process p3(exe, opts);
        p3.wait();
        assertEq(0, p3.exitCode(), "exit code p3");
    }

    namedArgumentTest() {
        hash<auto> options = {"path": (m_prefix,)};
        string output_command = getTestValue("testOutput");
        string true_command = getTestValue("testTrue");

        Process current(pid: getpid());
        assertEq(getpid(), current.id(), "named pid constructor");

        Process p(command: output_command, arguments: (), options: options);
        assertTrue(p.wait(timeout: 5s), "named wait");
        assertEq("stdout", p.readStdout(bytes: 100, timeout: 1s), "named readStdout");
        assertEq("stderr", p.readStderr(bytes: 100, timeout: 1s), "named readStderr");

        Process bin(command: output_command, arguments: (), options: options);
        assertTrue(bin.wait(timeout: 5s), "named binary wait");
        assertEq(<7374646f7574>, bin.readStdoutBinary(bytes: 100, timeout: 1s), "named readStdoutBinary");
        assertEq(<737464657272>, bin.readStderrBinary(bytes: 100, timeout: 1s), "named readStderrBinary");

        hash<auto> result = Process::run(command: output_command, arguments: NOTHING,
            options: options, timeout: 5s);
        assertEq(True, result.ok, "named Process::run ok");
        assertEq("stdout", result.stdout, "named Process::run stdout");
        assertEq("stderr", result.stderr, "named Process::run stderr");

        assertTrue(Process::commandExists(command: "ls"), "named commandExists");
        assertEq(m_prefix + true_command, Process::searchPath(command: true_command, options: options),
            "named searchPath");
        assertTrue(Process::checkPid(pid: getpid()), "named checkPid");
        assertGt(0, Process::getDescriptorCount(pid: getpid()), "named descriptor count");
        assertGt(0, Process::getCommandLine(pid: getpid()).size(), "named command line");

        hash<auto> pipe_result = Process::pipeline(commands: (("echo", "named-process"),));
        assertEq(True, pipe_result.ok, "named pipeline ok");
        assertEq("named-process\n", pipe_result.stdout, "named pipeline stdout");
    }

    private namedArgumentCompileOnly() {
        Process::terminate(pid: 1);
        Process::waitForTermination(pid: 1);
        hash<MemorySummaryInfo> memory_summary = Process::getMemorySummaryInfo(pid: getpid());
        hash<ResourceUsageInfo> resource_usage = Process::getResourceUsage(pid: getpid());
        list<int> child_pids = Process::getChildPids(pid: getpid());
        list<int> port_pids = Process::getPidsForPort(port: 80);
        list<int> socket_pids = Process::getPidsForUnixSocket(path: "/tmp/test.sock");
    }

    simpleTest() {
        Process p(getTestValue("simpleTest_exe"), getTestValue("simpleTest_arg"));
        assertEq(True, p.id() > 0, "PID must be given");
        assertEq(True, p.valid(), "process must be valid");

        p.wait();
        assertEq(0, p.exitCode());
    }

    simpleTestNegative() {
        try {
            Process p("some-not-existing-exec");
            p.wait();
            fail();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("PROCESS-SEARCH-PATH-ERROR", ex.err, "some-not-existing-exec for Process");
        }
    }

    ioTest() {
        string str = "text to write\n";
        hash<auto> opts = {
            "path": (m_prefix,),
        };
        Process p("test_io.q", opts);

        assertNothing(p.readStdout(1000));
        assertNothing(p.readStderr(1000));
        assertNothing(p.readStdoutBinary(1000));
        assertNothing(p.readStderrBinary(1000));

        p.write(str);

        string b1;
        # sleep to make sure that there is some stdout data ready
        while (True) {
            *string rd = p.readStdout(1);
            if (rd) {
                b1 = rd;
                break;
            }
            usleep(50ms);
        }

        assertEq("t", b1, "byte 1 stdout read test");
        string b2 = p.readStdout(2);
        assertEq("ex", b2, "byte 2 stdout read test");

        b2 = p.readStdout(1000);
        assertEq(str.substr(3), b2);

        b1 = p.readStderr(1);
        assertEq("1", b1, "byte 1 stderr read test");
        b2 = p.readStderr(2);
        assertEq("23", b2, "byte 2 stderr read test");

        for (int i = 0; i < 10; i++) {
            assertNothing(p.readStdout(1000));
            assertNothing(p.readStderr(1000));
            assertNothing(p.readStdoutBinary(1000));
            assertNothing(p.readStderrBinary(1000));
        }

        string testStr;
        for (int i = 0; i < 10; i++) {
            testStr += string(rand());
            testStr += testStr;
        }

        p.write(testStr + "\n");

        b1 = "";
        while (b1.size() < testStr.size()) {
            b1 += p.readStderr(1000);
        }
        assertEq(testStr, b1);

        b1 = "";
        while (b1.size() < testStr.size()) {
            b1 += p.readStdout(1000);
        }
        assertEq(testStr, b1);

        int retCode = (rand().abs() % 256);
        p.write(string(retCode) + "\n");

        assertTrue(p.wait(30s), "Process should complete within timeout");
        assertEq(False, p.running());
        assertEq(retCode, p.exitCode());

        # check partial multi-byte string retrieval
        str = "ステップの例";
        p = new Process("test_utf8.q", opts);
        # read 1 byte of stdout
        while (True) {
            *string rd = p.readStdout(1);
            if (rd) {
                b1 = rd;
                break;
            }
            usleep(50ms);
        }
        assertEq(str.substr(0, 1), b1);
        assertEq(str[1..], p.readStdout(100));
    }

    deadProcessIOTest() {
        # normally exited process
        {
            Process p(getTestValue("testSleep"), 1, ("path" : (m_prefix,)));
            assertTrue(p.wait());
            assertEq(0, p.exitCode(), "process exit code");
            assertFalse(p.running());

            assertEq(NOTHING, p.readStdout(1000));
            assertEq(NOTHING, p.readStderr(1000));
            assertEq(NOTHING, p.readStdout(1000, 200));
            assertEq(NOTHING, p.readStderr(1000, 200));

            p.write("lorem ipsum"); # shouldn't throw
        }

        # terminated process
        {
            Process p(getTestValue("testSleep"), 5, ("path" : (m_prefix,)));
            assertTrue(p.running());
            p.terminate();
            assertFalse(p.running());

            assertEq(NOTHING, p.readStdout(1000));
            assertEq(NOTHING, p.readStderr(1000));
            assertEq(NOTHING, p.readStdout(1000, 200));
            assertEq(NOTHING, p.readStderr(1000, 200));

            p.write("lorem ipsum"); # shouldn't throw
        }
    }

    executorsTest() {
        hash<auto> opts = {
            "path": ( m_prefix, ),
            "on_success": sub (hash<auto> e) {
                on_error printf("e: %N\n", e);
                if (m_options.verbose > 2)
                    printf("    on_success attribute: %y\n", e);

                assertEq("on_success", e.name, "name check");
                assertEq(m_prefix + getTestValue("testTrue"), e.exe, "on_success exe check");
                assertNothing(e.error_code, "on_success error_code check");
            },
            "on_setup": sub (hash<auto> e) {
                if (m_options.verbose > 2)
                    printf("    on_setup attribute: %y\n", e);
                assertEq("on_setup", e.name, "name check");
            },
            "on_error": sub (hash<auto> e) {
                if (m_options.verbose > 2)
                    printf("    on_error attribute: %y\n", e);
                assertEq("on_error", e.name, "name check");
            },
            "on_fork_error": sub (hash<auto> e) {
                if (m_options.verbose > 2)
                    printf("    on_fork_error attribute: %y\n", e);
                assertEq("on_fork_error", e.name, "name check");
            },
            "on_exec_setup": sub (hash<auto> e) {
                if (m_options.verbose > 2)
                    printf("    on_exec_setup attribute: %y\n", e);
                assertEq("on_exec_setup", e.name, "name check");
            },
            "on_exec_error": sub (hash<auto> e) {
                if (m_options.verbose > 2)
                    printf("    on_exec_error attribute: %y\n", e);
                assertEq("on_exec_error", e.name, "name check");
            },
        };

        Process p(getTestValue("testTrue"), opts);
        p.wait();
        assertEq(0, p.exitCode(), "expected 0 retval");

        opts."on_success" = sub (hash<auto> e) {
            if (m_options.verbose > 2)
                printf("    on_success attribute: %y\n", e);

            assertEq("on_success", e.name, "name check");
            assertEq(m_prefix + getTestValue("testFalse"), e.exe, "on_success exe check");
            assertNothing(e.error_code, "on_success error_code check");
        },
        p = new Process(getTestValue("testFalse"), opts);
        p.wait();
        assertEq(1, p.exitCode(), "expected 1 retval");
    }

    executorMethod(hash<auto> e) {
        if (m_options.verbose > 2)
            printf("executorMethod: %y\n", e);

        assertEq("on_success", e.name, "name check");
        assertEq(m_prefix + getTestValue("testTrue"), e.exe, "on_success exe check");
        assertNothing(e.error_code, "on_success error_code check");
    }

    static executorStaticMethod(hash<auto> e) {
        if (VERBOSE > 2)
            printf("executorStaticMethod: %y\n", e);

        MAIN.assertEq("on_success", e.name, "name check");
        MAIN.assertEq(MAIN.prefix() + MAIN.getTestValue("testTrue"), e.exe, "on_success exe check");
        MAIN.assertNothing(e.error_code, "on_success error_code check");
    }

    executorNoHash() {
        hash<auto> e = argv[0];
        if (m_options.verbose > 2)
            printf("executorNoHash: %y\n", e);

        assertEq("on_success", e.name, "name check");
        assertEq(m_prefix + getTestValue("testTrue"), e.exe, "on_success exe check");
        assertNothing(e.error_code, "on_success error_code check");
    }

    executorsRefsTest() {
        list<auto> opts = (
            {"on_success": \executor_func()}, # function ref
            {"on_success": \self.executorMethod()}, # method ref
            {"on_success": \Main::executorStaticMethod()}, # static method ref
            {"on_success": \self.executorNoHash()}, # no arguments
        );

        ListIterator it(opts);
        while (it.next()) {
            Process p(getTestValue("testTrue"), it.getValue() + ("path" : (m_prefix,)));
            p.wait();
            assertEq(0, p.exitCode(), "expected 0 retval");
        }
    }

    executorsNegativeTest() {
        try {
            hash<auto> opts = {
                "path": (m_prefix,),
                "on_success": 1,
            };
            Process p(getTestValue("testTrue"), opts);
        } catch (hash<ExceptionInfo> ex) {
            assertEq("PROCESS-OPTION-ERROR", ex.err, "on_success using integer: err");
            assertEq("executor 'on_success' required code as value, got: 'integer'(1)",
                ex.desc,
                "on_success using integer: desc"
            );
        }

        hash<auto> opts = {
            "path": (m_prefix,),
            "on_success": sub (int i) {},
        };
        assertThrows("RUNTIME-OVERLOAD-ERROR", "no variant matching",
            sub () { Process p(getTestValue("testTrue"), opts); }
        );
    }

    threadTest() {
        Process p("tee");
        assertEq(True, p.id() > 0, "PID must be given");
        assertEq(True, p.valid(), "process must be valid");
        assertEq(True, p.running(), "process must be running");

        Counter cnt(1);
        int tid = background run_bg(cnt, p, self);
        cnt.waitForZero();
        # NOTE: for the test to work, the background thread must be waiting on the process before we kill it
        while (True) {
            if (get_all_thread_call_stacks(){tid}[0].function == "Process::wait") {
                break;
            }
            usleep(10ms);
        }
        p.terminate();
    }

    envVarsTest() {
        hash<auto> opts_p = {
            "path": (m_prefix,),
            "env": Process::getEnvironment(),
        };

        {
            hash<auto> opts = opts_p;
            opts.env += {"FOO": "bar"};
            Process p("test_env.q", ("FOO", "bar"), opts);
            p.wait();
            assertEq(0, p.exitCode(), "env var retval for passed env");
        }

        # negative test
        {
            hash<auto> opts = opts_p;
            Process p("test_env.q", ("FOO", "bar"), opts);
            p.wait();
            assertEq(3, p.exitCode(), "env var retval for NOT passed env");
        }
    }

    envVarsNegativeTest() {
        hash<auto> opts = {
            "path": (m_prefix,),
            "env": 1, # let's try something else than hash for envs
        };

        try {
            Process p(getTestValue("testTrue"), opts);
            p.wait();
            fail();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("PROCESS-OPTION-ERROR", ex.err, "envVarsNegativeTest negative: err");
            assertEq("Environment variables option must be a hash, got: 'integer'(1)",
                     ex.desc,
                     "envVarsNegativeTest negative: desc"
            );
        }
    }

    cwdTest() {
        hash<auto> opts = {
            "cwd": Util::tmp_location(),
            "path": ( m_prefix, ),
        };
        {
            Process p("test_cwd.q", opts);
            # wait so there is surely stdout output
            string e;
            while (True) {
                *string str = p.readStdout(1000);
                if (str) {
                    e = str;
                    break;
                }
                usleep(50ms);
            }

            assertEq(opts.cwd, e, "cwd value read from stdout");

            p.wait();
            assertEq(0, p.exitCode(), "process exit code");
        }

        {
            Process p("test_cwd.q", opts);
            binary e;
            while (True) {
                *binary bin = p.readStdoutBinary(1000);
                if (bin) {
                    e = bin;
                    break;
                }
                usleep(50ms);
            }

            assertEq(opts.cwd, e.toString(), "cwd value read from stdout");

            p.wait();
            assertEq(0, p.exitCode(), "process exit code");
        }
    }

    pathTestNegative() {
        hash<auto> opts = {
            "path": ( "/", ),
        };
        try {
